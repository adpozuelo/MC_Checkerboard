! AVBMC-1 configurational-bias moves. Cluster border count is analysis only.
MODULE mod_avbmc
   Use set_precision
   Implicit None
   Integer :: nbrd = 0
   Real(wp) :: last_avbmc_p_in = 0.0_wp, last_avbmc_p_out = 0.0_wp
   Integer :: navbmc_in_att = 0, navbmc_in_acc = 0
   Integer :: navbmc_out_att = 0, navbmc_out_acc = 0
CONTAINS

   ! AVBMC-1 with fixed target/type pools and configurational bias.
   Subroutine attempt_avbmc_pair_moves(neighbors_in, offset_in, adjacency_in)
      Use rundata, Only: avbmc, beta, avbmc_k_trials, avbmc_max_trials, &
                         avbmc_target_types, avbmc_move_types, avbmc_p_in, avbmc_rbind
      Use potential, Only: rangepp
      Use configuration, Only: r, q, itype, Box, natoms, ndim
      Use properties, Only: En_tot
      Implicit None
      Integer, Intent(In) :: neighbors_in(natoms), offset_in(natoms), adjacency_in(:)
      Integer :: k, m, i, t, j, nt, ni, no, chosen
      Integer, Allocatable :: targets(:), inside(:), outside(:)
      Real(dkind), Allocatable :: weights(:)
      Real(wp), Allocatable :: energies(:), positions(:,:), orientations(:,:)
      Real(wp) :: rbind, vin, vout, vbox, r_old(3), q_old(4), &
                  e_old, e_eval, u
      Real(dkind) :: wnew, wold, a, cumulative, en_before
      Logical :: in_move, overlap, accepted_any
      Interface
         Subroutine calc_single_particle_energy(id_atom,r_pos,e_total,is_overlap,q_pos)
            Use set_precision
            Integer, Intent(In) :: id_atom
            Real(wp), Intent(In) :: r_pos(3)
            Real(wp), Intent(In), Optional :: q_pos(4)
            Real(wp), Intent(Out) :: e_total
            Logical, Intent(Out) :: is_overlap
         End Subroutine
      End Interface
      If (.Not. avbmc) Return
      rbind = avbmc_rbind
      If (rbind <= 0.0_wp) rbind = 1.5_wp*rangepp
      If (Any(rbind >= 0.5_wp*Box)) Stop 'AVBMC: rbind must be less than L/2 on every axis'
      vbox = Product(Box)
      vin = (4.0_wp/3.0_wp)*Acos(-1.0_wp)*rbind**3
      vout = vbox-vin
      Allocate(targets(natoms), inside(natoms), outside(natoms))
      Allocate(weights(avbmc_k_trials), energies(avbmc_k_trials))
      Allocate(positions(3,avbmc_k_trials), orientations(4,avbmc_k_trials))
      nt = 0
      Do i = 1, natoms
         If (avbmc_type_allowed(itype(i-1), avbmc_target_types)) Then
            nt = nt+1
            targets(nt) = i
         End If
      End Do
      If (nt == 0) Stop 'AVBMC: no particles of target types'
      accepted_any = .False.
      Call Convert_CB_RU()
      Do k = 1, avbmc_max_trials
         Call Random_number(u)
         t = targets(1+Int(u*nt))
         Call Random_number(u)
         in_move = u < avbmc_p_in
         If (in_move) Then
            navbmc_in_att = navbmc_in_att+1
         Else
            navbmc_out_att = navbmc_out_att+1
         End If
         ni = 0; no = 0
         Do i = 1, natoms
            If (i == t) Cycle
            If (.Not. avbmc_type_allowed(itype(i-1), avbmc_move_types)) Cycle
            If (avbmc_is_inside(r((i-1)*ndim:(i-1)*ndim+2), &
                                r((t-1)*ndim:(t-1)*ndim+2), Box, rbind)) Then
               ni = ni+1; inside(ni) = i
            Else
               no = no+1; outside(no) = i
            End If
         End Do
         If (in_move .and. no == 0) Cycle
         If (.Not. in_move .and. ni == 0) Cycle
         Call Random_number(u)
         If (in_move) Then
            j = outside(1+Int(u*no))
         Else
            j = inside(1+Int(u*ni))
         End If
         r_old = r((j-1)*ndim:(j-1)*ndim+2)
         q_old = q((j-1)*4:(j-1)*4+3)
         Call calc_single_particle_energy(j, r_old, e_old, overlap, q_old)
         If (overlap) Stop 'AVBMC: overlap in old state'
         wold = 1.0_wp
         Do m = 2, avbmc_k_trials
            Call avbmc_trial_position(r((t-1)*ndim:(t-1)*ndim+2), Box, rbind, .Not. in_move, positions(:,m))
            Call avbmc_random_quaternion(orientations(:,m))
            Call calc_single_particle_energy(j, positions(:,m), e_eval, overlap, orientations(:,m))
            If (.Not. overlap) wold = wold+Exp(-Real(beta,dkind)*Real(e_eval-e_old,dkind))
         End Do
         wnew = 0.0_wp
         Do m = 1, avbmc_k_trials
            Call avbmc_trial_position(r((t-1)*ndim:(t-1)*ndim+2), Box, rbind, in_move, positions(:,m))
            Call avbmc_random_quaternion(orientations(:,m))
            Call calc_single_particle_energy(j, positions(:,m), energies(m), overlap, orientations(:,m))
            weights(m) = 0.0_wp
            If (.Not. overlap) weights(m) = Exp(-Real(beta,dkind)*Real(energies(m)-e_old,dkind))
            wnew = wnew+weights(m)
         End Do
         If (wnew <= 0.0_wp .Or. wold <= 0.0_wp) Cycle
         Call Random_number(u)
         cumulative = 0.0_wp; chosen = avbmc_k_trials
         Do m = 1, avbmc_k_trials
            cumulative = cumulative+weights(m)
            If (u*wnew < cumulative) Then
               chosen = m; Exit
            End If
         End Do
         If (in_move) Then
            a = ((1.0_wp-avbmc_p_in)/avbmc_p_in)*(vin*no)/(vout*(ni+1))*wnew/wold
         Else
            a = (avbmc_p_in/(1.0_wp-avbmc_p_in))*(vout*ni)/(vin*(no+1))*wnew/wold
         End If
         Call Random_number(u)
         If (u >= Min(1.0_dkind,a)) Cycle
         If (in_move) Then
            navbmc_in_acc = navbmc_in_acc+1
         Else
            navbmc_out_acc = navbmc_out_acc+1
         End If
         r((j-1)*ndim:(j-1)*ndim+2) = positions(:,chosen)
         q((j-1)*4:(j-1)*4+3) = orientations(:,chosen)
         Call update_single_particle_cell(j, r_old, positions(:,chosen))
         En_tot = En_tot+energies(chosen)-e_old
         accepted_any = .True.
      End Do
      If (accepted_any) Then
         Call repopulate_checkerboard_cells()
         en_before = En_tot
         Call CB_system_energy_GPU(1)
         If (Abs(En_tot-en_before) > 1.0e-4_dkind*Max(1.0_dkind,Abs(En_tot))) Then
            Write(*,'(A,ES12.4)') ' AVBMC host/GPU energy drift: ', En_tot-en_before
         End If
      End If
   End Subroutine attempt_avbmc_pair_moves

   Logical Function avbmc_type_allowed(kind, allowed)
      Integer, Intent(In) :: kind, allowed(10)
      avbmc_type_allowed = All(allowed == -1) .Or. Any(allowed == kind+1)
   End Function avbmc_type_allowed

   Logical Function avbmc_is_inside(pos, target, box, rbind)
      Real(wp), Intent(In) :: pos(3), target(3), box(0:2), rbind
      Real(wp) :: dr(3)
      dr = pos-target
      dr = (dr-Anint(dr))*box(0:2)
      avbmc_is_inside = Sum(dr*dr) < rbind*rbind
   End Function avbmc_is_inside

   Subroutine avbmc_trial_position(target, box, rbind, inside, pos)
      Real(wp), Intent(In) :: target(3), box(0:2), rbind
      Logical, Intent(In) :: inside
      Real(wp), Intent(Out) :: pos(3)
      Real(wp) :: u(3), radius, theta, z
      If (inside) Then
         Call Random_number(u)
         radius = rbind*u(1)**(1.0_wp/3.0_wp)
         z = 2.0_wp*u(2)-1.0_wp
         theta = 2.0_wp*Acos(-1.0_wp)*u(3)
         pos(1) = target(1)+radius*Sqrt(1.0_wp-z*z)*Cos(theta)/box(0)
         pos(2) = target(2)+radius*Sqrt(1.0_wp-z*z)*Sin(theta)/box(1)
         pos(3) = target(3)+radius*z/box(2)
         pos = pos-Floor(pos)
      Else
         Do
            Call Random_number(pos)
            If (.Not. avbmc_is_inside(pos,target,box,rbind)) Exit
         End Do
      End If
   End Subroutine avbmc_trial_position

   Subroutine avbmc_random_quaternion(quat)
      Real(wp), Intent(Out) :: quat(4)
      Real(wp) :: u(3), a, b, theta, phi
      Call Random_number(u)
      a = Sqrt(1.0_wp-u(1)); b = Sqrt(u(1))
      theta = 2.0_wp*Acos(-1.0_wp)*u(2)
      phi = 2.0_wp*Acos(-1.0_wp)*u(3)
      quat = [b*Cos(phi), a*Sin(theta), a*Cos(theta), b*Sin(phi)]
   End Subroutine avbmc_random_quaternion

   Subroutine print_avbmc_stats()
      If (navbmc_in_att > 0) last_avbmc_p_in = Real(navbmc_in_acc, wp) / Real(navbmc_in_att, wp)
      If (navbmc_out_att > 0) last_avbmc_p_out = Real(navbmc_out_acc, wp) / Real(navbmc_out_att, wp)
   End Subroutine print_avbmc_stats

   Subroutine avbmc_finalize()
      ! Trial arrays are local allocatables and are released on return.
      nbrd = 0
      last_avbmc_p_in = 0.0_wp
      last_avbmc_p_out = 0.0_wp
      navbmc_in_att = 0
      navbmc_in_acc = 0
      navbmc_out_att = 0
      navbmc_out_acc = 0
   End Subroutine avbmc_finalize

END MODULE mod_avbmc
