! ==============================================================================
! MONTE CARLO SIMULATION CONTROL PARAMETERS
! ==============================================================================
&Control_Params
  istep_ini      = 0,          ! Initial step number (0 for new simulation, >0 for restart)
  istep_fin      = 40000,      ! Total number of MC sweeps (steps) to execute
  Neq            = 0,          ! Number of equilibration sweeps before accumulating averages
  Nmove          = 10,         ! Trial moves per particle attempted in each MC sweep
  Nsave          = 50,         ! Frequency (in sweeps) for writing progress stdout & block averages
  Ndump          = 100,        ! Frequency (in sweeps) for writing trajectory frames
  Nrestart       = 5000,       ! Frequency (in sweeps) for saving restart checkpoints
  imovie         = .true.,     ! Enable trajectory output (.true. / .false.)
  traj_format    = 'both',     ! Trajectory output format: 'plain' (text), 'netcdf' (binary), or 'both'
  Npart_types    = 2,          ! Number of particle species in system (2 for binary mixture)
  asym_threshold = 0.5,        ! Geometric asymmetry threshold for cluster border detection
  lammps         = .false.     ! Master switch: Enable hybrid LAMMPS HMC moves (disabled for LJ)
/

! ==============================================================================
! MONTE CARLO SAMPLING & THERMODYNAMIC PARAMETERS
! ==============================================================================
&MC_Params
  hmax         = 0.0125,       ! Maximum particle translation step size (in units of sigma)
  omax         = 0.5,          ! Maximum particle rotation step size (in radians)
  vmax         = 0.1, 0.1, 0.1,! Maximum box edge length displacement (Lx, Ly, Lz) for NpT moves
  displ_update = .true.,       ! Enable automatic adjustment of hmax/omax/vmax (~40% acceptance)
  temp0        = 1.54,         ! Initial reduced temperature T0* = kB*T/epsilon
  temp1        = 1.54,         ! Final reduced temperature T1* (set T1* != T0* for linear annealing)
  npt          = .false.,      ! Isobaric-isothermal ensemble (.true. for NpT, .false. for NVT)
  Nvolf        = 1,            ! Frequency (in sweeps) of NpT volume change attempts
  iscale       = 0,            ! Isotropic box scaling flag (0 = independent Lx,Ly,Lz, 1 = isotropic)
  pres         = 0.1,          ! Reduced pressure P* = P*sigma^3/epsilon (for NpT ensemble)
  seed         = 345,          ! Random number generator seed

  ! --- Multicomponent Mixture GPU Identity Swap Moves ---
  ! Identity swap moves are supported for multicomponent mixtures (Npart_types >= 2) across all potential models
  swap_moves   = .false.,      ! Enable GPU checkerboard identity swap moves (.true. / .false.)
  Nswap        = 1,            ! Number of swap sub-passes executed per swap step
  Nswapf       = 1             ! Frequency (in sweeps) of identity swap attempts
/

! ==============================================================================
! POTENTIAL MODEL SELECTION & PAIR PARAMETER MATRICES
! ==============================================================================
&Potential_Params
  model   = 'LJ',              ! Potential model: 'LJ' (Truncated & Shifted Lennard-Jones)
  rangepp = 2.5,               ! Potential radial cutoff distance in units of sigma_ij (Rcut = rangepp*sigma_ij)
/

  ! --- LJ SIGMA MATRIX ---
  ! Symmetric Npart_types x Npart_types matrix of LJ diameter parameters sigma_ij
1.000  1.200
1.200  1.400

  ! --- LJ EPSILON MATRIX ---
  ! Symmetric Npart_types x Npart_types matrix of LJ potential well depth parameters epsilon_ij
1.000  1.500
1.500  0.500


