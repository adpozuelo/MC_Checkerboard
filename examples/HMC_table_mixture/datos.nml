! ==============================================================================
! MONTE CARLO SIMULATION CONTROL PARAMETERS
! ==============================================================================
&Control_Params
  istep_ini      = 0,          ! Initial step number (0 for new simulation, >0 for restart)
  istep_fin      = 50,         ! Total number of MC sweeps (steps) to execute
  Neq            = 0,          ! Number of equilibration sweeps before accumulating averages
  Nmove          = 10,         ! Trial moves per particle attempted in each MC sweep
  Nsave          = 5,          ! Frequency (in sweeps) for writing progress stdout & block averages
  Ndump          = 25,         ! Frequency (in sweeps) for writing trajectory frames
  Nrestart       = 25,         ! Frequency (in sweeps) for saving restart checkpoints
  imovie         = .false.,    ! Enable trajectory output (.true. / .false.)
  traj_format    = 'plain',    ! Trajectory output format: 'plain' (text), 'netcdf' (binary), or 'both'
  Npart_types    = 2,          ! Number of particle species in system (2 for binary mixture)
  lammps         = .true.,     ! Master switch: Enable hybrid LAMMPS HMC moves (.true. / .false.)
  Ecpu_check     = .true.      ! Enable initial and final CPU energy verification
/

! ==============================================================================
! HYBRID MONTE CARLO (HMC) LAMMPS PARAMETERS
! ==============================================================================
&Lammps_Params
  timestep          = 0.001,   ! MD integration timestep in reduced units (alias: tstep_hmc)
  Nmd               = 10,      ! Number of MD integration steps per HMC trajectory segment (alias: Nmd_hmc)
  hmc_freq          = 5,       ! Cadence (in MC sweeps) of HMC trial moves (alias: Nmc_hmc)
  neigh_skin        = 0.3,     ! LAMMPS neighbor list skin thickness in simulation distance units
  thermo_freq       = 0,       ! LAMMPS internal thermodynamic output frequency (0 = quiet)
  use_gpu           = .true.,  ! Enable LAMMPS GPU acceleration package (-pk gpu 1 -sf gpu)
  gpu_id            = -1,      ! Target GPU device ID (-1 = automatically inherit MC device)
  table_lammps      = .true.,  ! Force tabulated force representation in LAMMPS
  table_file_lammps = 'pot'    ! Table file prefix (pot11.dat, pot12.dat, pot22.dat)
/

! ==============================================================================
! MONTE CARLO SAMPLING & THERMODYNAMIC PARAMETERS
! ==============================================================================
&MC_Params
  hmax         = 0.02,         ! Maximum particle translation step size (in units of sigma)
  omax         = 0.5,          ! Maximum particle rotation step size (in radians, ignored for isotropic)
  vmax         = 0.1, 0.1, 0.1,! Maximum box edge length displacement (Lx, Ly, Lz) for NpT moves
  displ_update = .true.,       ! Enable automatic adjustment of hmax/omax/vmax (~40% acceptance)
  temp0        = 1.0,          ! Initial reduced temperature T0* = kB*T/epsilon
  temp1        = 1.0,          ! Final reduced temperature T1*
  npt          = .false.,      ! Isobaric-isothermal ensemble (.true. for NpT, .false. for NVT)
  Nvolf        = 1,            ! Frequency (in sweeps) of NpT volume change attempts
  iscale       = 0,            ! Isotropic box scaling flag (0 = independent Lx,Ly,Lz, 1 = isotropic)
  pres         = 0.1,          ! Reduced pressure P*
  seed         = 12345,        ! Random number generator seed
  swap_moves   = .false.,      ! Identity swap moves between species 1 and 2 (.true. / .false.)
  Nswap        = 1,            ! Number of swap sub-passes per swap step
  Nswapf       = 1             ! Frequency (in sweeps) of identity swap attempts
/

! ==============================================================================
! POTENTIAL MODEL SELECTION & TABULATED POTENTIAL CONFIGURATION
! ==============================================================================
&Potential_Params
  model         = 'TABLE',     ! Potential model: 'TABLE' (tabulated isotropic pair interactions)
  table_mc      = .true.,      ! Enable MC table potential evaluations on GPU
  table_file_mc = 'pot'        ! Prefix for potential table files (pot11.dat, pot12.dat, pot22.dat)
/
