#!/bin/sh
# Resolve symlinks before locating the architecture binaries.
script=$0
while [ -L "$script" ]; do
    dir=$(CDPATH= cd -P "$(dirname "$script")" && pwd) || exit 1
    link=$(readlink "$script") || exit 1
    case $link in
        /*) script=$link ;;
        *) script=$dir/$link ;;
    esac
done
dir=$(CDPATH= cd -P "$(dirname "$script")" && pwd) || exit 1
if [ -r /proc/cpuinfo ] && grep -Eq '(^|[[:space:]])avx512f([[:space:]]|$)' /proc/cpuinfo && [ -x "$dir/MCCB-gpu-v4" ]; then
    chosen=$dir/MCCB-gpu-v4
elif [ -x "$dir/MCCB-gpu-v3" ]; then
    chosen=$dir/MCCB-gpu-v3
elif [ -x "$dir/MCCB-gpu-v4" ]; then
    chosen=$dir/MCCB-gpu-v4
else
    echo 'MCCB-gpu: no architecture binary found (MCCB-gpu-v3 or MCCB-gpu-v4)' >&2
    exit 1
fi
[ "${MCCB_LAUNCHER_DEBUG:-0}" = 1 ] && echo "MCCB-gpu: exec $chosen" >&2
exec "$chosen" "$@"
