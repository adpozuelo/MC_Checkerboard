! ==============================================================================
! PROGRAM: MC_CB-GPU
! ==============================================================================
! DESCRIPTION:
!   GPU-accelerated Monte Carlo simulation for patchy particle systems in
!   NVT or NpT ensemble.
!   Uses checkerboard decomposition for parallel MC
!   moves on GPU, with Lennard-Jones-Gauss potential including angular and
!   torsional interactions.
!
! FEATURES:
!   - GPU-parallelized energy calculations and MC moves
!   - Checkerboard cell decomposition for conflict-free parallel updates
!   - Translation, rotation, and volume (NpT) MC moves
!   - Adaptive displacement parameters
!   - Temperature annealing capability
!   - Trajectory output and restart files
!   - Accurate periodic CPU & GPU execution timings
!
! AUTHORS:
!   Eva González Noya      - eva.noya@iqf.csic.es
!   Antonio Díaz Pozuelo   - adiaz@iqf.csic.es
!
! DATE:
!   February 2026
! ==============================================================================

Program MC_CB_GPU

   Use set_precision

   Use configuration
   Use properties
   Use potential
   Use rundata
   Use cell

   Use cuda_fortran, only: limpio, compute_per_atom_energy_gpu
   Use tools
   Use cudafor                            ! Required for cudaEvent structures
   Use netcdf_trajectory
   Use mod_clusters
   Use mod_avbmc
   Use lammps_hmc_wrapper, only: init_hmc_lammps, execute_hmc_step, close_hmc_lammps
   Use mpi

   Implicit None
   Integer :: i, j, ll, Iend, Ieq, vec_shift(6,0:ndim-1), vec(0:ndim-1), k_swap
   Integer :: ierr
   Integer :: ngpus,gpuid,Njumps, Nsteps_DeltaT, Natoms_aux, lammps_devNum
   Integer :: total_sites
   Character(len=256) :: hdr_title, hdr_sep, banner_txt
   Integer :: len_hdr, k, pad_len

   Real(wp) :: rnd, disp(0:ndim-1), start, finish, omaxo, hmaxo, prob_vol, vmaxo(0:ndim-1)
   Real(wp) :: rnd_vec(ndim), prob_trans, prob_rot, prob_swap, boxmin, W_RU_min
   Real(wp) :: total_gpu_time
   Real(wp) :: P_HS
   Real(dkind) :: En_tot_old
   Logical :: overlap=.false.

   ! Array for NetCDF per-atom instantaneous energies
   Real(wp), Allocatable :: atom_energies_host(:)

   ! --------------------------------------------------------------------------
   ! CPU & GPU Timing Variables
   ! --------------------------------------------------------------------------
   Type(cudaEvent) :: startEvent, stopEvent
   Real(4)         :: gpu_time_ms, last_gpu_time_ms, diff_gpu_time_ms
   Real(wp)        :: cpu_time_now, last_cpu_time, diff_cpu_time
   Integer         :: istat
   ! Control input args
   integer         :: devNum, argc
   character(len=2) :: deviceNumber

   ! --------------------------------------------------------------------------
   ! ANSI Color Codes & Date/Time Variables
   ! --------------------------------------------------------------------------
   Character(len=8) :: c_red, c_green, c_yellow, c_blue, c_cyan, c_reset
   Character(len=8)  :: dt_date
   Character(len=10) :: dt_time
   Character(len=5)  :: dt_zone
   Integer           :: dt_values(8)

   call MPI_Init(ierr)
   c_red    = char(27)//'[1;31m'
   c_green  = char(27)//'[1;32m'
   c_yellow = char(27)//'[1;33m'
   c_blue   = char(27)//'[1;34m'
   c_cyan   = char(27)//'[1;36m'
   c_reset  = char(27)//'[0m'

   ! Command line arguments control
   argc = command_argument_count()
   if (argc < 1) then
      write(*,"(A,'!!! Error: You must specify at least ONE argument: the name of the ')")c_red
      write(*,"('    input file e.g.: mc_gpu.exe input_file.nml')")
      write(*,"('    Second argument (optional) is the GPU device number to use, (default 0)',A)")c_reset
      stop
   end if
   ! Get input filename and optional GPU device number
   call get_command_argument(1, input_filename)
   if (argc >= 2) then
      call get_command_argument(2, deviceNumber)
      read(deviceNumber,*) devNum
   else
      devNum = 0
   end if

   ! Get optional 3rd argument for LAMMPS GPU device
   if (argc >= 3) then
      call get_command_argument(3, deviceNumber)
      read(deviceNumber,*) lammps_devNum
   else
      lammps_devNum = devNum
   end if
   ! --------------------------------------------------------------------------
   ! Initialization Banner
   ! --------------------------------------------------------------------------
   Call date_and_time(dt_date, dt_time, dt_zone, dt_values)

   write(*,'(A)') c_blue // '========================================================================================' // c_reset
   write(*,'(A)') c_cyan // '                          HYBRID MC_CB-GPU/LAMMPS SIMULATION ENGINE                            ' // c_reset
   write(*,'(A)') c_cyan // '                                   Version 2.5                                        ' // c_reset
   write(*,'(A)') c_blue // '========================================================================================' // c_reset
   write(*,'(A,I4,A,I2.2,A,I2.2,A,I2.2,A,I2.2,A,I2.2,A)') c_green // ' >>> Run started on: ', &
      dt_values(1), '-', dt_values(2), '-', dt_values(3), ' at ', &
      dt_values(5), ':', dt_values(6), ':', dt_values(7), c_reset
   write(*,'(A)') c_blue // '----------------------------------------------------------------------------------------' // c_reset

   call gpucount(ngpus)
   if (devNum >= 0) Then
      call choosegpu(devNum)
   endif
   write(*,"(A,i2,A)") c_cyan // ' *** GPU Devices Available: ' // c_reset, ngpus, ' ***'
   if (ngpus==0) Then
      write(*,"(A)") c_red//' *** Fatal error: no gpu available' // c_reset
      stop
   endif

   call Print_GPU_Properties()

   write(*,'(A)') c_blue // '========================================================================================' // c_reset

   write(*,*)

   ! --------------------------------------------------------------------------
   ! Read input parameters and initial configuration
   ! --------------------------------------------------------------------------
   write(*,'(A)') c_yellow // ' >>> Initializing System and Reading Data...' // c_reset
   Call Read_input_data
   Call load_table_potentials
   Call Read_init_conf

   ! Calculate total number of sites
   total_sites = natoms
   if (pot_int == 2) then
      do i = 0, natoms - 1
         total_sites = total_sites + Nrb_sites(itype(i))
      end do
   end if

   Call Get_Inverse_matrix
   Call Convert_Box_Units
   Call Initialize_variables

   Allocate(atom_energies_host(0:Natoms-1))
   write(*,'(A)') c_green // ' >>> Initialization complete.' // c_reset
   write(*,*)

   ! --------------------------------------------------------------------------
   ! Calculate initial energy using CPU version (verification)
   ! --------------------------------------------------------------------------
   If (Ecpu_check) Then
      call cpu_time(start)
      If (pot_int /= -1) Then
         write(*,'(A)') c_yellow // ' >>> Evaluating initial CPU energy for verification...' // c_reset
      Else
         write(*,'(A)') c_yellow // ' >>> Checking initial CPU configuration for overlaps...' // c_reset
      EndIf
      Call system_energy(overlap)
      call cpu_time(finish)
      If (pot_int /= -1) write(*,'(A,e13.6,A)') '     Time initial energy = ', finish-start, ' seconds.'

      If (overlap) Then
         write(*,'(A)') c_red // ' [ERROR] Overlap detected in initial configuration!' // c_reset
         stop
      EndIf
      If (pot_int /= -1) Call print_ener
   endif
   ! --------------------------------------------------------------------------
   ! Initialize checkerboard cell decomposition & GPU Energy
   ! --------------------------------------------------------------------------
   Call Initialize_checkerboard
   if (Nmc_hmc > 0) call init_hmc_lammps(lammps_devNum)
   NCell_max=Ntot_Cell*10

   call cpu_time(start)
   If (pot_int /= -1) Then
      write(*,'(A)') c_yellow // ' >>> Evaluating initial GPU checkerboard energy...' // c_reset
   Else
      write(*,'(A)') c_yellow // ' >>> Checking initial GPU configuration for overlaps...' // c_reset
   EndIf
   En_tot = 0
   Call CB_system_energy_gpu(init)
   call cpu_time(finish)

   If (pot_int /= -1) Then
      write(*,'(A,f18.8)') c_green // '     Initial GPU energy = ' // c_reset, En_tot
      write(*,'(A,e13.6,A)') '     Time initial GPU energy = ', finish-start, ' seconds.'
      write(*,*)
   EndIf

   If (overlap) Then
      write(*,'(A)') c_red // ' [ERROR] Overlap in initial configuration!' // c_reset
      stop
   EndIf

   ! --------------------------------------------------------------------------
   ! Setup main simulation loop parameters
   ! --------------------------------------------------------------------------
   Iend=istep_ini+istep_fin
   IEq=istep_ini+Neq

   vec_shift(1,:) = (/  1,  0,  0 /)
   vec_shift(2,:) = (/ -1,  0,  0 /)
   vec_shift(3,:) = (/  0,  1,  0 /)
   vec_shift(4,:) = (/  0, -1,  0 /)
   vec_shift(5,:) = (/  0,  0,  1 /)
   vec_shift(6,:) = (/  0,  0, -1 /)

   init=1

   ! Trajectory files setup
   If (trim(traj_format) == 'plain' .or. trim(traj_format) == 'both') Then
      open(133,file='movie.xyz',status='replace')
      open(674,file='trajectory.lammpstrj',status='replace')
   EndIf
   If (trim(traj_format) == 'netcdf' .or. trim(traj_format) == 'both') Then
      Call netcdf_init_trajectory('trajectory.nc', Natoms)
   EndIf
   write(*,'(A,A)') c_cyan // ' >>> Trajectory Format Enabled: ' // c_reset, trim(traj_format)

   ! Initialize counters
   no_mc_real=0
   ntrans_ac=0
   nrot_ac=0

   ! Absolute step index at which equilibration ends and production begins
   Ieq = istep_ini + Neq

   ! Setup temperature annealing schedule
   Njumps=(istep_fin-istep_ini)/Nsave
   DeltaT=((Temp1-Temp0)/dble(Njumps-1))
   Temp = Temp0
   beta=1.d0/Temp

   If (abs(DeltaT) > 1.0e-12_wp) Then
      write(*,'(A,i10)')    '     Number of temperature jumps: ', Njumps
      write(*,'(A,f12.8)')  '     DeltaT: ', DeltaT
      write(*,*)
   End If

   ! --------------------------------------------------------------------------
   ! MAIN MONTE CARLO LOOP
   ! --------------------------------------------------------------------------
   ! Formatted headers for NpT vs NVT with optional cluster analysis and AVBMC columns
   hdr_title = ''
   If (NpT) Then
      If (pot_int == -1) Then
         hdr_title = '      Step   P σ³/kT          Density    P_TransN_Trans/step    move/part      P_Vol       vmax       N_Cell'
      ElseIf (pot_int < 1) Then
         hdr_title = '      Step          En_tot/N    En_tot/Ns       Density    P_TransN_Trans/step    move/part      P_Vol       vmax       N_Cell'
      Else
         hdr_title = '      Step          En_tot/N    En_tot/Ns       Density    P_Trans      P_RotN_Trans/step    move/part      P_Vol       vmax       N_Cell'
      EndIf
   Else
      If (pot_int == -1) Then
         hdr_title = '      Step   P σ³/kT        P_TransN_Trans/step    move/part       N_Cell'
      ElseIf (pot_int < 1) Then
         hdr_title = '      Step          En_tot/N    En_tot/Ns    P_TransN_Trans/step    move/part       N_Cell'
      Else
         hdr_title = '      Step          En_tot/N    En_tot/Ns    P_Trans      P_RotN_Trans/step    move/part       N_Cell'
      EndIf
   EndIf

   If (ncluster > 0) Then
      hdr_title = trim(hdr_title) // '  N_Clust   Max_Cl  %Clust'
   EndIf

   If (avbmc) Then
      hdr_title = trim(hdr_title) // '   P_AV_in  P_AV_out'
   EndIf

   If (swap_moves) Then
      hdr_title = trim(hdr_title) // '    P_Swap'
   EndIf

   hdr_title = trim(hdr_title) // '     CPU(s)     GPU(s)'

   len_hdr = len_trim(hdr_title)
   hdr_sep = ''
   Do k = 1, len_hdr
      hdr_sep(k:k) = '-'
   End Do

   banner_txt = 'MAIN MONTE CARLO LOOP STARTED'
   pad_len = max(0, (len_hdr - len_trim(banner_txt)) / 2)

   write(*,*)
   write(*,'(A)') c_blue // hdr_sep(1:len_hdr) // c_reset
   write(*,'(A)') c_cyan // repeat(' ', pad_len) // trim(banner_txt) // c_reset
   write(*,'(A)') c_blue // hdr_sep(1:len_hdr) // c_reset
   write(*,'(A)') c_yellow // trim(hdr_title) // c_reset
   write(*,'(A)') c_blue // hdr_sep(1:len_hdr) // c_reset

   ! --- Initialize Timers ---
   istat = cudaEventCreate(startEvent)
   istat = cudaEventCreate(stopEvent)
   last_gpu_time_ms = 0.0
   total_gpu_time = 0.0

   call cpu_time(start)
   last_cpu_time = start
   istat = cudaEventRecord(startEvent, 0)

   Do I = 1+istep_ini, istep_ini+Neq+istep_fin

      ! Perform MC sweep or Hybrid MC step
      if (Nmc_hmc > 0 .and. mod(I, Nmc_hmc) == 0) then
         call execute_hmc_step(I)
         call cpu_time(last_cpu_time)
         istat = cudaEventRecord(startEvent, 0)
         last_gpu_time_ms = 0.0
      else
         ! ====================================================================
         ! MONTE CARLO SWEEP (PARTICLE MOVES)
         ! ====================================================================
         ! MCsweep() performs 1 full Monte Carlo sweep over all 8 checkerboard
         ! cell sets (Nset_Cell = 8 in 3D), covering 100% of particles in the box.
         ! For every particle, subsweepgpu executes Nmove trial move attempts:
         !   - Isotropic models (pot_int < 1): Nmove translation attempts / particle.
         !   - Patchy models (pot_int >= 1): Nmove/2 translations + Nmove/2 rotations
         !     = Nmove total trial moves per particle per sweep.
         ! ====================================================================
         Call MCsweep()
         ! >>> ADD THIS FORCIBLE SYNC <<<
         ! Ensure all GPU writes to Sphere_Cell are done before CPU touches it
         istat = cudaDeviceSynchronize()
         ! Randomly shift cell boundaries to avoid artifacts
         Call Random_number(rnd)
         disp(:) = rnd*disp_max(:)
         Call Random_number(rnd)
         vec(:)  = vec_shift ( int(rnd*size(vec_shift,1))+1, :)
         Call Shift_Cells(vec,disp)

         ! Perform Identity Swap moves on GPU if enabled (binary HS mixtures only)
         If (swap_moves .and. Npart_types == 2 .and. pot_int == -1 .and. mod(I, Nswapf) == 0) Then
            Do k_swap = 1, Nswap
               Call MCswap_Checkerboard()
            End Do
            istat = cudaDeviceSynchronize()
         End If

         ! Volume move for NpT ensemble
         If(NpT .and. mod(I, Nvolf) == 0) then
            Call Volume_move
            nvol=nvol+1
         EndIf

         ! Accumulate Virial pressure histogram for hard-sphere runs
         If (pot_int == -1 .and. mod(I, max(1, Nsave/10)) == 0) Then
            Call Convert_CB_RU
            Call Accumulate_HS_Virial_Histogram()
         EndIf
      end if

      ! Accumulate averages and adjust parameters
      If (mod(i,Nsave)==0) Then
         If (pot_int /= -1) Call Accumulate_averages(i)
         if (pot_int < 1) then
            Ntrans=no_mc_real*Nmove
         else
            Ntrans=no_mc_real*Nmove/2
            Nrot=no_mc_real*Nmove/2
         endif
         if (Ntrans > 0) then
            prob_trans=dble(ntrans_ac)/dble(ntrans)
         else
            prob_trans=0.0d0
         endif
         if (Nrot > 0) then
            prob_rot=dble(nrot_ac)/dble(nrot)
         else
            prob_rot=0.0d0
         endif
         if (nvol > 0) then
            prob_vol=dble(nvol_accept)/dble(nvol)
         else
            prob_vol=0.0d0
         endif
         if (swap_moves) then
            if (nswap_att > 0) then
               prob_swap = dble(nswap_acc)/dble(nswap_att)
            else
               prob_swap = 0.0d0
            end if
            ! Auto-throttle swap frequency to once every 100 steps if acceptance drops below 0.00005
            if (nswap_att >= 1000) then
               if (prob_swap < 0.00005_wp .and. Nswapf < 100) then
                  Nswapf = 100
                  write(*,*)
                  write(*,'(A)') c_yellow // ' ---------------------------------------------------------------------------------------------------' // c_reset
                  write(*,'(A,f10.6,A)') c_yellow // '  >>> [INFO] Swap acceptance (P_swap = ', prob_swap, ') fell below threshold (0.00005).' // c_reset
                  write(*,'(A)') c_yellow // '             Throttling identity swap frequency to once every 100 steps (Nswapf = 100).' // c_reset
                  write(*,'(A)') c_yellow // ' ---------------------------------------------------------------------------------------------------' // c_reset
                  write(*,*)
               else if (prob_swap >= 0.00005_wp .and. Nswapf == 100) then
                  Nswapf = 1
                  write(*,*)
                  write(*,'(A)') c_green // ' ---------------------------------------------------------------------------------------------------' // c_reset
                  write(*,'(A,f10.6,A)') c_green // '  >>> [INFO] Swap acceptance (P_swap = ', prob_swap, ') recovered above threshold (0.00005).' // c_reset
                  write(*,'(A)') c_green // '             Restoring identity swap frequency to once every step (Nswapf = 1).' // c_reset
                  write(*,'(A)') c_green // ' ---------------------------------------------------------------------------------------------------' // c_reset
                  write(*,*)
               end if
            end if
         endif
         ! Autoadjust maximum displacement up to 0.4
         If (displ_update) then
            hmaxo=hmax
            if (prob_trans > 0.001d0) then
               hmax=hmax*dabs(prob_trans/0.4d0)
            else
               hmax=hmax*0.8d0
            endif
            ! Put a limit to the displacement
            if(hmax/hmaxo > 1.5d0) hmax=hmaxo*1.5
            if(hmax/hmaxo < 0.5d0) hmax=hmaxo*0.5
            W_RU_min=minval(W_RU)
            ! Maximum displacement is limited by half of the minimum W_RU
            ! which is the connected with the sise of subcells
            if(hmax > W_RU_min/2.d0 ) hmax =W_RU_min/2.d0
            if(hmax < 0.001d0 / box(0)) hmax = 0.001d0 / box(0)
            if (pot_int > 0) then
               ! Autoadjust maximum rotation up to 0.5 radians
               omaxo=omax
               if (prob_rot > 0.001d0) then
                  omax=omax*dabs(prob_rot/0.4d00)
               else
                  omax=omax*0.8d0
               endif
               if(omax/omaxo.gt.1.5d00) omax=omaxo*1.5d00
               if(omax/omaxo.lt.0.5d00) omax=omaxo*0.5d00
               if(omax.gt.0.5d0) omax=0.5d0
               if(omax < 0.01d0) omax = 0.01d0
            endif
            vmaxo(0:2)=vmax(0:2)
            boxmin=minval(box)
            ! Autoadjust volume displacements
            if(prob_vol.eq.0) then
               vmax(0:2)=vmaxo(0:2)*0.5
            else
               if(vmax(0).ne.0) then
                  vmax(0)=vmax(0)*dabs(prob_vol/0.4d0)
                  vmax(1)=vmax(0)*box(1)/boxmin
                  vmax(2)=vmax(0)*box(2)/boxmin
               else
                  vmax(1)=vmax(1)*dabs(prob_vol/0.4d0)
                  vmax(2)=vmax(2)*dabs(prob_vol/0.4d0)
               endif
               if(vmax(0)/vmaxo(0) > 1.5d0) vmax(0)=vmaxo(0)*1.5
               if(vmax(1)/vmaxo(1) > 1.5d0) vmax(1)=vmaxo(1)*1.5
               if(vmax(2)/vmaxo(2) > 1.5d0) vmax(2)=vmaxo(2)*1.5
               if(vmax(0)/vmaxo(0) < 0.5d0) vmax(0)=vmaxo(0)*0.5
               if(vmax(1)/vmaxo(1) < 0.5d0) vmax(1)=vmaxo(1)*0.5
               if(vmax(2)/vmaxo(2) < 0.5d0) vmax(2)=vmaxo(2)*0.5
            endif
         EndIf
         ! >>> THE DRIFT KILLER: Reset the accumulator from scratch periodically
         ! Doing this every 50 steps takes almost zero time but clears all FP32 noise
         If (mod(i, 5*Nsave) == 0) Then
            Call CB_system_energy_gpu(1)
         EndIf


         ! --- Compute Periodic Timers ---
         call cpu_time(cpu_time_now)
         diff_cpu_time = cpu_time_now - last_cpu_time
         last_cpu_time = cpu_time_now

         istat = cudaEventRecord(stopEvent, 0)
         istat = cudaEventSynchronize(stopEvent)
         istat = cudaEventElapsedTime(diff_gpu_time_ms, startEvent, stopEvent)
         If (diff_gpu_time_ms /= diff_gpu_time_ms .or. diff_gpu_time_ms <= 0.0) diff_gpu_time_ms = Real(diff_cpu_time * 1000.0_wp, 4)
         total_gpu_time = total_gpu_time + (real(diff_gpu_time_ms, wp) / 1000.0_wp)

         ! Execute cluster analysis and AVBMC moves if scheduled for this step
         If( (ncluster > 0) .AND. (mod(i, ncluster) == 0) ) Then
            Call Convert_CB_RU
            Call run_cluster_analysis(i)
            If (avbmc) Then
               Call attempt_avbmc_pair_moves(neighbors, offset, adjacency)
               Call print_avbmc_stats()
            End If
         EndIf
         ! Compute Virial Pressure for hard-sphere runs
         If (pot_int == -1) Then
            Call Convert_CB_RU
            Call HS_Virial_Pressure(P_HS)
            Call Accumulate_averages(i, P_HS)
         EndIf

         ! --- Format terminal output based on ensemble and active features ---
         If (NpT) Then
             If (pot_int == -1) Then
                If (ncluster > 0 .and. avbmc) Then
                   write(*,'(i10, f14.6, f14.6, f11.4, i12, f13.6, 2f11.4, i13, 2i9, f8.2, 2f10.4, 2f11.3)') &
                      i, P_HS, rho, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, last_avbmc_p_in, last_avbmc_p_out, diff_cpu_time, diff_gpu_time_ms / 1000.0
                ElseIf (ncluster > 0) Then
                   write(*,'(i10, f14.6, f14.6, f11.4, i12, f13.6, 2f11.4, i13, 2i9, f8.2, 2f11.3)') &
                      i, P_HS, rho, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, diff_cpu_time, diff_gpu_time_ms / 1000.0
                ElseIf (swap_moves) Then
                   write(*,'(i10, f14.6, f14.6, f11.4, i12, f13.6, 2f11.4, i13, f10.5, 2f11.3)') &
                      i, P_HS, rho, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, prob_swap, diff_cpu_time, diff_gpu_time_ms / 1000.0
                Else
                   write(*,'(i10, f14.6, f14.6, f11.4, i12, f13.6, 2f11.4, i13, 2f11.3)') &
                      i, P_HS, rho, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, diff_cpu_time, diff_gpu_time_ms / 1000.0
                EndIf
             ElseIf (pot_int < 1) Then
               If (ncluster > 0 .and. avbmc) Then
                  write(*,'(i10, f18.8, f13.8, f14.6, f11.4, i12, f13.6, 2f11.4, i13, 2i9, f8.2, 2f10.4, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), rho, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, last_avbmc_p_in, last_avbmc_p_out, diff_cpu_time, diff_gpu_time_ms / 1000.0
               ElseIf (ncluster > 0) Then
                  write(*,'(i10, f18.8, f13.8, f14.6, f11.4, i12, f13.6, 2f11.4, i13, 2i9, f8.2, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), rho, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, diff_cpu_time, diff_gpu_time_ms / 1000.0
               ElseIf (swap_moves) Then
                  write(*,'(i10, f18.8, f13.8, f14.6, f11.4, i12, f13.6, 2f11.4, i13, f10.5, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), rho, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, prob_swap, diff_cpu_time, diff_gpu_time_ms / 1000.0
               Else
                  write(*,'(i10, f18.8, f13.8, f14.6, f11.4, i12, f13.6, 2f11.4, i13, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), rho, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, diff_cpu_time, diff_gpu_time_ms / 1000.0
               EndIf
            Else
               If (ncluster > 0 .and. avbmc) Then
                  write(*,'(i10, f18.8, f13.8, f14.6, 2f11.4, i12, f13.6, 2f11.4, i13, 2i9, f8.2, 2f10.4, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), rho, prob_trans, prob_rot, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, last_avbmc_p_in, last_avbmc_p_out, diff_cpu_time, diff_gpu_time_ms / 1000.0
               ElseIf (ncluster > 0) Then
                  write(*,'(i10, f18.8, f13.8, f14.6, 2f11.4, i12, f13.6, 2f11.4, i13, 2i9, f8.2, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), rho, prob_trans, prob_rot, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, diff_cpu_time, diff_gpu_time_ms / 1000.0
               Else
                  write(*,'(i10, f18.8, f13.8, f14.6, 2f11.4, i12, f13.6, 2f11.4, i13, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), rho, prob_trans, prob_rot, ntrans/nsave, real(ntrans)/real(nsave*natoms), prob_vol, vmax(0), Ntot_Cell, diff_cpu_time, diff_gpu_time_ms / 1000.0
               EndIf
            EndIf
         Else
            If (pot_int == -1) Then
               If (ncluster > 0 .and. avbmc) Then
                  write(*,'(i10, f14.6, f11.4, i12, f13.6, i13, 2i9, f8.2, 2f10.4, 2f11.3)') &
                     i, P_HS, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, last_avbmc_p_in, last_avbmc_p_out, diff_cpu_time, diff_gpu_time_ms / 1000.0
               ElseIf (ncluster > 0) Then
                  write(*,'(i10, f14.6, f11.4, i12, f13.6, i13, 2i9, f8.2, 2f11.3)') &
                     i, P_HS, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, diff_cpu_time, diff_gpu_time_ms / 1000.0
               ElseIf (swap_moves) Then
                  write(*,'(i10, f14.6, f11.4, i12, f13.6, i13, f10.5, 2f11.3)') &
                     i, P_HS, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, prob_swap, diff_cpu_time, diff_gpu_time_ms / 1000.0
               Else
                  write(*,'(i10, f14.6, f11.4, i12, f13.6, i13, 2f11.3)') &
                     i, P_HS, prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, diff_cpu_time, diff_gpu_time_ms / 1000.0
               EndIf
            ElseIf (pot_int < 1) Then
               If (ncluster > 0 .and. avbmc) Then
                  write(*,'(i10, f18.8, f13.8, f11.4, i12, f13.6, i13, 2i9, f8.2, 2f10.4, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, last_avbmc_p_in, last_avbmc_p_out, diff_cpu_time, diff_gpu_time_ms / 1000.0
               ElseIf (ncluster > 0) Then
                  write(*,'(i10, f18.8, f13.8, f11.4, i12, f13.6, i13, 2i9, f8.2, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, diff_cpu_time, diff_gpu_time_ms / 1000.0
               ElseIf (swap_moves) Then
                  write(*,'(i10, f18.8, f13.8, f11.4, i12, f13.6, i13, f10.5, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, prob_swap, diff_cpu_time, diff_gpu_time_ms / 1000.0
               Else
                  write(*,'(i10, f18.8, f13.8, f11.4, i12, f13.6, i13, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), prob_trans, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, diff_cpu_time, diff_gpu_time_ms / 1000.0
               EndIf
            Else
               If (ncluster > 0 .and. avbmc) Then
                  write(*,'(i10, f18.8, f13.8, 2f11.4, i12, f13.6, i13, 2i9, f8.2, 2f10.4, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), prob_trans, prob_rot, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, last_avbmc_p_in, last_avbmc_p_out, diff_cpu_time, diff_gpu_time_ms / 1000.0
               ElseIf (ncluster > 0) Then
                  write(*,'(i10, f18.8, f13.8, 2f11.4, i12, f13.6, i13, 2i9, f8.2, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), prob_trans, prob_rot, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, last_nclusters, last_max_size, last_pct_clustered, diff_cpu_time, diff_gpu_time_ms / 1000.0
               Else
                  write(*,'(i10, f18.8, f13.8, 2f11.4, i12, f13.6, i13, 2f11.3)') &
                     i, En_tot/real(natoms), En_tot/real(total_sites), prob_trans, prob_rot, ntrans/nsave, real(ntrans)/real(nsave*natoms), Ntot_Cell, diff_cpu_time, diff_gpu_time_ms / 1000.0
               EndIf
            EndIf
         EndIf

         if (swap_moves .and. i > Ieq) then
            nswap_att_tot = nswap_att_tot + int(nswap_att, 8)
            nswap_acc_tot = nswap_acc_tot + int(nswap_acc, 8)
         end if
         no_mc_real=0
         ntrans_ac=0
         nrot_ac=0
         nswap_att=0
         nswap_acc=0
         nvol=0
         nvol_accept=0

         Temp=Temp+DeltaT
         beta=1.d0/Temp
         istat = cudaEventRecord(startEvent, 0)
      EndIf

      ! Write trajectory snapshots
      If( (i > istep_ini + Neq) .AND. (mod(i,Ndump)==0) ) Then
         Call Convert_CB_RU
         Call compute_per_atom_energy_gpu(pot_int, bool_tor, ndim, Nat_cell_max, Ntot_Cell, Npart_types, &
            Nrb_sites_max, Ntor_max, sigma_tor_jon, sigp_factor, Rcp_factor, Rc_factor, Natoms, atom_energies_host)

         If (trim(traj_format) == 'plain' .or. trim(traj_format) == 'both') Then
            Call Write_movie(i)
            Call Write_final_conf2(i)
         EndIf
         If (trim(traj_format) == 'netcdf' .or. trim(traj_format) == 'both') Then
            If (pot_int == -1) Then
               Call HS_Virial_Pressure(P_HS)
               Call netcdf_write_frame(i, Natoms, r, q, itype, h, beta, atom_energies_host, P_HS)
            Else
               Call netcdf_write_frame(i, Natoms, r, q, itype, h, beta, atom_energies_host)
            EndIf
         EndIf
      EndIf


      ! Write restart files periodically
      If(mod(i,Nrestart)==0) Then
         Call Convert_CB_RU
         Call Write_final_conf
         Call Write_Input_File(i)
         En_tot_old=En_tot
         Call CB_system_energy_gpu(1)
         If (pot_int == -1) Then
            write(*,'(A,i10)') c_green // '     [CHECKPOINT] Saved at step: ' // c_reset, i
         Else
            write(*,'(A,i10,A,f18.8)') c_green // '     [CHECKPOINT] Saved at step: ' // c_reset, i, ' | En_tot = ', En_tot
         EndIf
      EndIf

      ! Reset counters and timers at the end of the equilibration phase to prevent accumulation in printed statistics
      If (i == Ieq) Then
         banner_txt = '>>> EQUILIBRATION PHASE FINISHED - PRODUCTION PHASE STARTED <<<'
         pad_len = max(0, (len_hdr - len_trim(banner_txt)) / 2)

         write(*,*)
         write(*,'(A)') c_green // hdr_sep(1:len_hdr) // c_reset
         write(*,'(A)') c_green // repeat(' ', pad_len) // trim(banner_txt) // c_reset
         write(*,'(A)') c_green // hdr_sep(1:len_hdr) // c_reset
         write(*,*)
         no_mc_real = 0
         ntrans_ac = 0
         nrot_ac = 0
         nswap_att = 0
         nswap_acc = 0
         nvol = 0
         nvol_accept = 0
         Call cpu_time(last_cpu_time)
         istat = cudaEventRecord(startEvent, 0)
      EndIf

   End Do

   ! Flush remaining production swap counts if loop ended between Nsave steps
   if (swap_moves .and. istep_fin > Ieq) then
      nswap_att_tot = nswap_att_tot + int(nswap_att, 8)
      nswap_acc_tot = nswap_acc_tot + int(nswap_acc, 8)
   end if

   ! --------------------------------------------------------------------------
   ! End of main loop
   ! --------------------------------------------------------------------------
   banner_txt = 'MAIN MONTE CARLO LOOP FINISHED'
   pad_len = max(0, (len_hdr - len_trim(banner_txt)) / 2)

   write(*,'(A)') c_blue // hdr_sep(1:len_hdr) // c_reset
   write(*,'(A)') c_cyan // repeat(' ', pad_len) // trim(banner_txt) // c_reset
   write(*,'(A)') c_blue // hdr_sep(1:len_hdr) // c_reset

   ! --- Compute Global Timers ---
   call cpu_time(finish)
   istat = cudaEventRecord(stopEvent, 0)
   istat = cudaEventSynchronize(stopEvent)
   istat = cudaEventElapsedTime(gpu_time_ms, startEvent, stopEvent)

   If (pot_int /= -1) write(*,'(A,f18.8)') c_green // ' >>> Final energy after MC moves = ' // c_reset, En_tot
   If (swap_moves) Then
      write(*,'(A,i12,A,i12,A,f8.2,A)') '     Identity Swaps (Production): Attempted = ', nswap_att_tot, &
                                        ', Accepted = ', nswap_acc_tot, &
                                        ' (', 100.0_wp * real(nswap_acc_tot, wp)/max(1.0_wp, real(nswap_att_tot, wp)), ' %)'
   End If
   write(*,'(A,f13.3,A)') '     Total CPU Time spent in main loop = ', finish-start, ' seconds.'
   write(*,'(A,f13.3,A)') '     Total GPU Time spent in main loop = ', total_gpu_time, ' seconds.'
   write(*,*)

   ! Clean up CUDA events
   istat = cudaEventDestroy(startEvent)
   istat = cudaEventDestroy(stopEvent)

   If (trim(traj_format) == 'plain' .or. trim(traj_format) == 'both') close(133)
   If (trim(traj_format) == 'netcdf' .or. trim(traj_format) == 'both') Call netcdf_close_trajectory()

   ! --------------------------------------------------------------------------
   ! Final energy calculation and output
   ! --------------------------------------------------------------------------
   overlap=.false.
   Call CB_system_energy_gpu(2)
   If (pot_int /= -1) write(*,'(A,f18.8)') c_yellow // ' >>> Final energy evaluated with GPU = ' // c_reset, En_tot

   Call Convert_CB_RU
   Call Calculate_averages
   Call Write_final_properties

   If (ncluster > 0) Then
      If (avbmc) Then
         Call run_cluster_analysis(istep_ini+istep_fin)
         Call attempt_avbmc_pair_moves(neighbors, offset, adjacency)
         Call print_avbmc_stats()
      End If
      ! Final cluster analysis on post-AVBMC state so all cluster outputs match the final configuration
      Call run_cluster_analysis(istep_ini+istep_fin)
   End If

   Call Write_final_conf
   Call Write_final_conf2(istep_ini+istep_fin)

   if (Nmc_hmc > 0) call close_hmc_lammps()
   Call limpio
   Call clusters_dealloc()
   write(*,'(A)') c_green // ' >>> Simulation completely finished. GPU memory cleaned.' // c_reset
   call MPI_Finalize(ierr)

End Program MC_CB_GPU
