MODULE mod_clusters
    Use set_precision
    Use configuration
    Use rundata, Only : rcl, minPts, ncluster, cluster_types, istep_ini, pot_int, asym_threshold, avbmc, &
                        border_criterion, energy_threshold, energy_border_ratio, use_energy_ratio, &
                        n_avbmc, ncluster_init, cluster_threshold, bound_min_neighbors, cluster_regime_large
    Use potential, Only : bool_tor, Npart_types, Nrb_sites_max, Ntor_max, sigma_tor_jon, sigp_factor, Rcp_factor, Rc_factor
    Use mod_avbmc
    Use cudafor
    Use Cell, Only : Ntot_Cell, Nat_Cell_Max, Sphere_Cell, List_Cell, Nat_Cell, DR_Cell, Map_Cell
    Use cuda_fortran, Only : Sphere_Celldev, List_Cell_dev, Map_Cell_dev, Nat_Cell_dev, DR_Cell_dev, hdev, compute_per_atom_energy_gpu
    Use, Intrinsic :: iso_fortran_env, Only: error_unit
    Implicit None

    Integer, Parameter :: maxnbpp = 128

    ! GPU grid parameters
    Integer :: nthread = 256
    Integer :: nbcuda

    ! Host arrays for clustering
    Integer, Allocatable, Dimension(:) :: label
    Integer, Allocatable, Dimension(:) :: neighbors
    Integer, Allocatable, Dimension(:) :: offset
    Integer, Allocatable, Dimension(:) :: adjacency
    Integer, Allocatable, Dimension(:) :: filled
    Integer, Allocatable, Dimension(:) :: lookup_host

    ! Device arrays for GPU-accelerated DBSCAN
    Integer, Device, Allocatable, Dimension(:) :: glabel
    Integer, Device, Allocatable, Dimension(:) :: gborder
    Integer, Device, Allocatable, Dimension(:) :: gneighbors
    Integer, Device, Allocatable, Dimension(:) :: goffset
    Integer, Device, Allocatable, Dimension(:) :: gadjacency
    Integer, Device, Allocatable, Dimension(:) :: gfilled
    Integer, Device, Allocatable, Dimension(:) :: gcluster_mask
    Integer, Device, Allocatable, Save :: glookup(:)

    Integer :: io_clusevol_file = 111
    Character(len=32) :: clusevol_filename = 'clusevol_mc.dat'

    ! Latest cluster statistics for table output
    Integer :: last_nclusters = 0
    Integer :: last_max_size = 0
    Real(wp) :: last_pct_clustered = 0.0_wp
    Integer :: cluster_diagnostic_step = 0

CONTAINS

    ! GPU BFS kernel
    Attributes(Global) Subroutine gbfs(Nsites, cluster_id, minPts, active)
        Integer, Value, Intent(IN) :: Nsites, cluster_id, minPts
        Logical, Intent(INOUT) :: active
        Integer :: j, nbj, offj
        j = (blockidx%x - 1)*blockdim%x + threadidx%x
        If (j <= Nsites) Then
            If (gborder(j) == 1 .And. glabel(j) == 0) Then
                glabel(j) = cluster_id
                nbj = gneighbors(j)
                offj = goffset(j)
                If (nbj >= minPts - 1) Then
                    active = .True.
                    gborder(gadjacency(offj:offj+nbj-1)) = 1
                End If
            End If
        End If
    End Subroutine gbfs

    ! Adjacency count kernel (O(N^2) GPU direct search)
    Attributes(Global) Subroutine gpu_graf(r, Nsites, dim, rcl2, sidel, minPts, mask)
        Integer, Value, Intent(IN) :: Nsites, dim, minPts
        Real(wp), Value :: rcl2
        Real(wp), Intent(IN) :: r(Nsites*dim), sidel(dim)
        Integer, Intent(IN) :: mask(Nsites)
        Real(wp) :: dx, dy, dz, rr2, xi, yi, zi
        Integer :: i, j, counter, indx_i, indx_j
        i = (blockidx%x - 1)*blockdim%x + threadidx%x
        If (i <= Nsites) Then
            gneighbors(i) = 0
            If (mask(i) == 0) Return
            
            counter = 0
            indx_i = (i - 1) * dim
            xi = r(indx_i + 1)
            yi = r(indx_i + 2)
            zi = r(indx_i + 3)
            
            Do j = 1, Nsites
                If (i /= j .And. mask(j) /= 0) Then
                    indx_j = (j - 1) * dim
                    dx = xi - r(indx_j + 1)
                    dy = yi - r(indx_j + 2)
                    dz = zi - r(indx_j + 3)
                    
                    ! PBC
                    dx = dx - sidel(1) * anint(dx / sidel(1))
                    dy = dy - sidel(2) * anint(dy / sidel(2))
                    dz = dz - sidel(3) * anint(dz / sidel(3))
                    
                    rr2 = dx*dx + dy*dy + dz*dz
                    If (rr2 <= rcl2) Then
                        counter = counter + 1
                    End If
                End If
            End Do
            gneighbors(i) = counter
        End If
    End Subroutine gpu_graf

    ! Adjacency populate kernel
    Attributes(Global) Subroutine gpu_adj(r, Nsites, dim, rcl2, sidel, mask)
        Integer, Value, Intent(IN) :: Nsites, dim
        Real(wp), Value :: rcl2
        Real(wp), Intent(IN) :: r(Nsites*dim), sidel(dim)
        Integer, Intent(IN) :: mask(Nsites)
        Real(wp) :: dx, dy, dz, rr2, xi, yi, zi
        Integer :: i, j, counter, indx_i, indx_j
        i = (blockidx%x - 1)*blockdim%x + threadidx%x
        If (i <= Nsites) Then
            If (mask(i) == 0) Return
            
            counter = 0
            indx_i = (i - 1) * dim
            xi = r(indx_i + 1)
            yi = r(indx_i + 2)
            zi = r(indx_i + 3)
            
            Do j = 1, Nsites
                If (i /= j .And. mask(j) /= 0) Then
                    indx_j = (j - 1) * dim
                    dx = xi - r(indx_j + 1)
                    dy = yi - r(indx_j + 2)
                    dz = zi - r(indx_j + 3)
                    
                    ! PBC
                    dx = dx - sidel(1) * anint(dx / sidel(1))
                    dy = dy - sidel(2) * anint(dy / sidel(2))
                    dz = dz - sidel(3) * anint(dz / sidel(3))
                    
                    rr2 = dx*dx + dy*dy + dz*dz
                    If (rr2 <= rcl2) Then
                        gadjacency(goffset(i) + counter) = j
                        counter = counter + 1
                    End If
                End If
            End Do
        End If
    End Subroutine gpu_adj

    ! GPU lookup builder kernel
    Attributes(Global) Subroutine build_offset_lookup(List_Cell, Nat_Cell, Nat_Cell_Max, Ntot_Cell, Particle_to_CellOffset)
        Implicit None
        Integer, Value, Intent(IN) :: Nat_Cell_Max, Ntot_Cell
        Integer, Intent(IN) :: List_Cell(0:*), Nat_Cell(0:*)
        Integer, Intent(OUT) :: Particle_to_CellOffset(0:*)
        Integer :: icell, j, jmol, ipart
        
        icell = (blockidx%x - 1)*blockdim%x + threadidx%x - 1
        if (icell < Ntot_Cell) then
            do j = 0, Nat_Cell(icell) - 1
                jmol = icell * Nat_Cell_Max * 2 + j * 2
                ipart = List_Cell(jmol) ! Particle ID (0 to Natoms-1)
                Particle_to_CellOffset(ipart) = icell * Nat_Cell_Max + j
            end do
        end if
    End Subroutine build_offset_lookup

    ! Cell-list GPU neighbor count kernel
    Attributes(Global) Subroutine gpu_graf_cell(Sphere_Cell, List_Cell, Map_Cell, Nat_Cell, DR_Cell, &
                                               Lookup, Nat_Cell_Max, Ntot_Cell, Nsites, dim, rcl2, h, mask, gneighbors)
        Implicit None
        Integer, Value, Intent(IN) :: Nat_Cell_Max, Ntot_Cell, Nsites, dim
        Real(wp), Value :: rcl2
        real(wp), device, intent(in) :: Sphere_Cell(0:*), DR_Cell(0:*), h(0:*)
        integer, device, intent(in) :: List_Cell(0:*), Map_Cell(0:*), Nat_Cell(0:*)
        integer, device, intent(in) :: Lookup(0:*)
        integer, device, intent(in) :: mask(*)
        integer, device, intent(out) :: gneighbors(*)
        
        integer :: i, cell_offset, icell, j_offset, counter, jcell, k, kpart, n, nneigh
        real(wp) :: xi, yi, zi, xj, yj, zj, dx, dy, dz, dxp, dyp, dzp, rr2
        real(wp) :: dx_shift, dy_shift, dz_shift
        
        i = (blockidx%x - 1)*blockdim%x + threadidx%x
        If (i <= Nsites) Then
            gneighbors(i) = 0
            If (mask(i) == 0) Return
            
            counter = 0
            cell_offset = Lookup(i-1)
            icell = cell_offset / Nat_Cell_Max
            j_offset = mod(cell_offset, Nat_Cell_Max)
            
            xi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4))
            yi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4) + 1)
            zi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4) + 2)
            
            ! 1. Check particles in same cell
            do k = 0, Nat_Cell(icell) - 1
                kpart = List_Cell(icell * Nat_Cell_Max * 2 + k * 2)
                if (i-1 /= kpart .and. mask(kpart+1) /= 0) then
                    xj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4))
                    yj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 1)
                    zj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 2)
                    dx = xj - xi
                    dy = yj - yi
                    dz = zj - zi
                    dxp = h(0)*dx + h(1)*dy + h(2)*dz
                    dyp = h(3)*dx + h(4)*dy + h(5)*dz
                    dzp = h(6)*dx + h(7)*dy + h(8)*dz
                    rr2 = dxp*dxp + dyp*dyp + dzp*dzp
                    if (rr2 <= rcl2) then
                        counter = counter + 1
                    end if
                end if
            end do
            
            ! 2. Check particles in neighbor cells
            if (dim == 3) then
                nneigh = 26
            else
                nneigh = 8
            endif
            
            do n = 0, nneigh - 1
                jcell = Map_Cell(icell * nneigh + n)
                dx_shift = DR_Cell(icell * nneigh * dim + n * dim)
                dy_shift = DR_Cell(icell * nneigh * dim + n * dim + 1)
                dz_shift = 0.0_wp
                if (dim == 3) dz_shift = DR_Cell(icell * nneigh * dim + n * dim + 2)
                
                do k = 0, Nat_Cell(jcell) - 1
                    kpart = List_Cell(jcell * Nat_Cell_Max * 2 + k * 2)
                    if (mask(kpart+1) /= 0) then
                        xj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4)) + dx_shift
                        yj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 1) + dy_shift
                        zj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 2) + dz_shift
                        dx = xj - xi
                        dy = yj - yi
                        dz = zj - zi
                        dxp = h(0)*dx + h(1)*dy + h(2)*dz
                        dyp = h(3)*dx + h(4)*dy + h(5)*dz
                        dzp = h(6)*dx + h(7)*dy + h(8)*dz
                        rr2 = dxp*dxp + dyp*dyp + dzp*dzp
                        if (rr2 <= rcl2) then
                            counter = counter + 1
                        end if
                    end if
                end do
            end do
            
            gneighbors(i) = counter
        End If
    End Subroutine gpu_graf_cell

    ! Cell-list GPU neighbor populate kernel
    Attributes(Global) Subroutine gpu_adj_cell(Sphere_Cell, List_Cell, Map_Cell, Nat_Cell, DR_Cell, &
                                              Lookup, Nat_Cell_Max, Ntot_Cell, Nsites, dim, rcl2, h, mask, goffset, gadjacency, gfilled)
        Implicit None
        Integer, Value, Intent(IN) :: Nat_Cell_Max, Ntot_Cell, Nsites, dim
        Real(wp), Value :: rcl2
        real(wp), device, intent(in) :: Sphere_Cell(0:*), DR_Cell(0:*), h(0:*)
        integer, device, intent(in) :: List_Cell(0:*), Map_Cell(0:*), Nat_Cell(0:*)
        integer, device, intent(in) :: Lookup(0:*)
        integer, device, intent(in) :: mask(*)
        integer, device, intent(in) :: goffset(*)
        integer, device, intent(out) :: gadjacency(*)
        integer, device, intent(out) :: gfilled(*)
        
        integer :: i, cell_offset, icell, j_offset, counter, jcell, k, kpart, n, nneigh
        real(wp) :: xi, yi, zi, xj, yj, zj, dx, dy, dz, dxp, dyp, dzp, rr2
        real(wp) :: dx_shift, dy_shift, dz_shift
        
        i = (blockidx%x - 1)*blockdim%x + threadidx%x
        If (i <= Nsites) Then
            gfilled(i) = 0
            If (mask(i) == 0) Return
            
            counter = 0
            cell_offset = Lookup(i-1)
            icell = cell_offset / Nat_Cell_Max
            j_offset = mod(cell_offset, Nat_Cell_Max)
            
            xi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4))
            yi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4) + 1)
            zi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4) + 2)
            
            ! 1. Check particles in same cell
            do k = 0, Nat_Cell(icell) - 1
                kpart = List_Cell(icell * Nat_Cell_Max * 2 + k * 2)
                if (i-1 /= kpart .and. mask(kpart+1) /= 0) then
                    xj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4))
                    yj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 1)
                    zj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 2)
                    dx = xj - xi
                    dy = yj - yi
                    dz = zj - zi
                    dxp = h(0)*dx + h(1)*dy + h(2)*dz
                    dyp = h(3)*dx + h(4)*dy + h(5)*dz
                    dzp = h(6)*dx + h(7)*dy + h(8)*dz
                    rr2 = dxp*dxp + dyp*dyp + dzp*dzp
                    if (rr2 <= rcl2) then
                        gadjacency(goffset(i) + counter) = kpart + 1 ! 1-indexed particle ID
                        counter = counter + 1
                    end if
                end if
            end do
            
            ! 2. Check particles in neighbor cells
            if (dim == 3) then
                nneigh = 26
            else
                nneigh = 8
            endif
            
            do n = 0, nneigh - 1
                jcell = Map_Cell(icell * nneigh + n)
                dx_shift = DR_Cell(icell * nneigh * dim + n * dim)
                dy_shift = DR_Cell(icell * nneigh * dim + n * dim + 1)
                dz_shift = 0.0_wp
                if (dim == 3) dz_shift = DR_Cell(icell * nneigh * dim + n * dim + 2)
                
                do k = 0, Nat_Cell(jcell) - 1
                    kpart = List_Cell(jcell * Nat_Cell_Max * 2 + k * 2)
                    if (mask(kpart+1) /= 0) then
                        xj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4)) + dx_shift
                        yj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 1) + dy_shift
                        zj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 2) + dz_shift
                        dx = xj - xi
                        dy = yj - yi
                        dz = zj - zi
                        dxp = h(0)*dx + h(1)*dy + h(2)*dz
                        dyp = h(3)*dx + h(4)*dy + h(5)*dz
                        dzp = h(6)*dx + h(7)*dy + h(8)*dz
                        rr2 = dxp*dxp + dyp*dyp + dzp*dzp
                        if (rr2 <= rcl2) then
                            gadjacency(goffset(i) + counter) = kpart + 1 ! 1-indexed particle ID
                            counter = counter + 1
                        end if
                    end if
                end do
            end do
            gfilled(i) = counter
        End If
    End Subroutine gpu_adj_cell


    Subroutine clusters_alloc()
        If (.Not. Allocated(gneighbors)) Then
            Allocate(gneighbors(natoms))
            Allocate(goffset(natoms))
            Allocate(gadjacency(natoms * maxnbpp))
            Allocate(gfilled(natoms))
            Allocate(glabel(natoms))
            Allocate(gborder(natoms))
            Allocate(gcluster_mask(natoms))
            Allocate(glookup(0:natoms-1))
            
            Allocate(label(natoms))
            Allocate(neighbors(natoms))
            Allocate(offset(natoms))
            Allocate(adjacency(natoms * maxnbpp))
            Allocate(filled(natoms))
            Allocate(lookup_host(0:natoms-1))
        End If
    End Subroutine clusters_alloc

    Subroutine clusters_dealloc()
        If (Allocated(gneighbors)) Deallocate(gneighbors)
        If (Allocated(goffset)) Deallocate(goffset)
        If (Allocated(gadjacency)) Deallocate(gadjacency)
        If (Allocated(gfilled)) Deallocate(gfilled)
        If (Allocated(glabel)) Deallocate(glabel)
        If (Allocated(gborder)) Deallocate(gborder)
        If (Allocated(gcluster_mask)) Deallocate(gcluster_mask)
        If (Allocated(glookup)) Deallocate(glookup)
        If (Allocated(label)) Deallocate(label)
        If (Allocated(neighbors)) Deallocate(neighbors)
        If (Allocated(offset)) Deallocate(offset)
        If (Allocated(adjacency)) Deallocate(adjacency)
        If (Allocated(filled)) Deallocate(filled)
        If (Allocated(lookup_host)) Deallocate(lookup_host)
    End Subroutine clusters_dealloc

    Subroutine neighbor_search(Nsites_val)
        Integer, Intent(IN) :: Nsites_val
        Integer :: istat, i
        Integer :: nblock_lookup
        Real(wp) :: search_rcl2
        
        gneighbors(:) = 0
        gadjacency(:) = 0
        
        ! Ensure device arrays are allocated (handles cases where they were cleaned up or deallocated)
        if (.not. allocated(Sphere_Celldev)) allocate(Sphere_Celldev(0:Ntot_Cell*Nat_Cell_Max*(ndim+4)-1))
        if (.not. allocated(List_Cell_dev)) allocate(List_Cell_dev(0:Ntot_Cell*Nat_Cell_Max*2-1))
        if (.not. allocated(Nat_Cell_dev)) allocate(Nat_Cell_dev(0:Ntot_Cell-1))
        if (.not. allocated(DR_Cell_dev)) allocate(DR_Cell_dev(0:Ntot_Cell*26*3-1))
        if (.not. allocated(hdev)) allocate(hdev(0:ndim*ndim-1))
        if (.not. allocated(Map_Cell_dev)) then
            allocate(Map_Cell_dev(0:Ntot_Cell*26-1))
            Map_Cell_dev = Map_Cell
        endif
        
        ! Synchronize host cell structures to device
        Sphere_Celldev = Sphere_Cell
        List_Cell_dev = List_Cell
        Nat_Cell_dev = Nat_Cell
        DR_Cell_dev = DR_Cell
        hdev = h
        ! The GPU's cell-relative arithmetic can round a contact on the
        ! boundary differently from the minimum-image arithmetic used by
        ! AVBMC graph updates. Search a small envelope, then apply that exact
        ! host predicate while building a reciprocal graph.
        search_rcl2 = (rcl + 64.0_wp*Epsilon(rcl)*Max(1.0_wp,Maxval(Box)))**2
        
        ! 1. Build particle-to-cell offset lookup array on GPU
        nblock_lookup = (Ntot_Cell + nthread - 1)/nthread
        if (nblock_lookup == 0) nblock_lookup = 1
        Call build_offset_lookup<<<nblock_lookup, nthread>>>(List_Cell_dev, Nat_Cell_dev, Nat_Cell_Max, Ntot_Cell, glookup)
        istat = cudaDeviceSynchronize()
        If (avbmc_graph_checks .And. cluster_diagnostic_step >= avbmc_graph_check_from_step) Then
            Call validate_cluster_lookup(cluster_diagnostic_step)
        End If
        
        ! 2. Launch cell-list neighbor count kernel
        Call gpu_graf_cell<<<nbcuda, nthread>>>(Sphere_Celldev, List_Cell_dev, Map_Cell_dev, Nat_Cell_dev, DR_Cell_dev, &
                                               glookup, Nat_Cell_Max, Ntot_Cell, Nsites_val, ndim, search_rcl2, hdev, gcluster_mask, gneighbors)
        istat = cudaDeviceSynchronize()
        
        ! 3. Copy neighbor counts to host to compute exclusive prefix scan (offset list)
        neighbors(:) = gneighbors(:)
        
        ! Check neighbor count limit
        If (Maxval(neighbors) > maxnbpp) Then
            Write(*, '(A, I5, A, I5)') '*** Error: max neighbors detected is ', Maxval(neighbors), &
                                       ' which exceeds maxnbpp = ', maxnbpp
            Write(*, '(A)') '*** Please increase maxnbpp in input file or decrease rcl.'
            Stop
        End If
        
        ! 4. Compute exclusive prefix sum (offset) on the host starting at 1
        offset(1) = 1
        Do i = 2, Nsites_val
            offset(i) = offset(i-1) + neighbors(i-1)
        End Do
        
        ! 5. Copy offset back to device
        goffset(:) = offset(:)
        
        ! 6. Launch cell-list adjacency list kernel
        Call gpu_adj_cell<<<nbcuda, nthread>>>(Sphere_Celldev, List_Cell_dev, Map_Cell_dev, Nat_Cell_dev, DR_Cell_dev, &
                                              glookup, Nat_Cell_Max, Ntot_Cell, Nsites_val, ndim, search_rcl2, hdev, gcluster_mask, goffset, &
                                              gadjacency, gfilled)
        istat = cudaDeviceSynchronize()
        If (avbmc_graph_checks .And. cluster_diagnostic_step >= avbmc_graph_check_from_step) Then
            filled(:) = gfilled(:)
            Do i = 1, Nsites_val
                If (filled(i) == neighbors(i)) Cycle
                Write(error_unit,*) 'Cluster GPU count/fill mismatch: step/particle/count/filled', &
                                     cluster_diagnostic_step, i, neighbors(i), filled(i)
                Error Stop 'Cluster GPU count/fill mismatch'
            End Do
        End If
        
        ! 7. Copy adjacency list back to host
        adjacency(:) = gadjacency(:)
        Call canonicalize_cluster_graph(Nsites_val)
        
    End Subroutine neighbor_search

    Subroutine canonicalize_cluster_graph(Nsites_val)
        Integer, Intent(In) :: Nsites_val
        Integer, Allocatable :: raw_count(:), raw_offset(:), raw_adj(:), pair_i(:), pair_j(:), cursor(:)
        Integer(8), Allocatable :: hash_key(:)
        Integer(8) :: key
        Integer :: i, j, k, a, b, npairs, slot, table_size, edge_capacity
        Real(wp) :: dr(3)
        edge_capacity = Sum(neighbors(1:Nsites_val))
        raw_count = neighbors(1:Nsites_val)
        raw_offset = offset(1:Nsites_val)
        raw_adj = adjacency(1:edge_capacity)
        Allocate(pair_i(edge_capacity), pair_j(edge_capacity), cursor(Nsites_val))
        table_size = Max(17,2*edge_capacity+1)
        Allocate(hash_key(table_size))
        hash_key = 0_8
        neighbors(1:Nsites_val) = 0
        npairs = 0
        Do i = 1, Nsites_val
            Do k = raw_offset(i), raw_offset(i)+raw_count(i)-1
                j = raw_adj(k)
                If (j < 1 .Or. j > Nsites_val .Or. j == i) Then
                    Write(error_unit,*) 'Cluster GPU graph invalid neighbor: step/i/j', cluster_diagnostic_step, i, j
                    Error Stop 'Cluster GPU graph invalid neighbor'
                End If
                dr = r((j-1)*ndim:(j-1)*ndim+2)-r((i-1)*ndim:(i-1)*ndim+2)
                dr = (dr-Anint(dr))*Box(0:2)
                If (Sum(dr*dr) >= rcl*rcl) Cycle
                a = Min(i,j)
                b = Max(i,j)
                key = Int(a-1,8)*Int(Nsites_val,8)+Int(b,8)
                slot = Int(Mod(key,Int(table_size,8)))+1
                Do While (hash_key(slot) /= 0_8 .And. hash_key(slot) /= key)
                    slot = Mod(slot,table_size)+1
                End Do
                If (hash_key(slot) == key) Cycle
                hash_key(slot) = key
                npairs = npairs+1
                pair_i(npairs) = a
                pair_j(npairs) = b
                neighbors(a) = neighbors(a)+1
                neighbors(b) = neighbors(b)+1
            End Do
        End Do
        If (Maxval(neighbors(1:Nsites_val)) > maxnbpp) Then
            Write(error_unit,*) 'Cluster canonical graph exceeds maxnbpp at step', cluster_diagnostic_step
            Error Stop 'Cluster canonical graph overflow'
        End If
        offset(1) = 1
        Do i = 2, Nsites_val
            offset(i) = offset(i-1)+neighbors(i-1)
        End Do
        cursor = offset(1:Nsites_val)
        Do k = 1, npairs
            a = pair_i(k)
            b = pair_j(k)
            adjacency(cursor(a)) = b
            cursor(a) = cursor(a)+1
            adjacency(cursor(b)) = a
            cursor(b) = cursor(b)+1
        End Do
    End Subroutine canonicalize_cluster_graph

    Subroutine validate_cluster_lookup(istep)
        Integer, Intent(In) :: istep
        Integer :: icell, slot, particle, expected
        Integer, Allocatable :: map_copy(:)
        lookup_host = glookup
        Do icell = 0, Ntot_Cell-1
            Do slot = 0, Nat_Cell(icell)-1
                particle = List_Cell(icell*Nat_Cell_Max*2+slot*2)
                expected = icell*Nat_Cell_Max+slot
                If (lookup_host(particle) /= expected) Then
                    Write(error_unit,*) 'Cluster GPU lookup mismatch: step/id/expected/actual', &
                                         istep, particle+1, expected, lookup_host(particle)
                    Error Stop 'Cluster GPU lookup mismatch'
                End If
            End Do
        End Do
        map_copy = Map_Cell_dev
        If (Any(map_copy /= Map_Cell)) Then
            Write(error_unit,*) 'Cluster GPU cell map mismatch at step', istep
            Error Stop 'Cluster GPU cell map mismatch'
        End If
    End Subroutine validate_cluster_lookup

    Subroutine diagnose_cluster_edge(i, j)
        Integer, Intent(In) :: i, j
        Integer :: ci, cj, si, sj, n, neighbor_cell
        Real(wp) :: xi(3), xj(3), shift(3), dx(3), physical(3)
        ci = lookup_host(i-1)/Nat_Cell_Max
        si = Mod(lookup_host(i-1),Nat_Cell_Max)
        cj = lookup_host(j-1)/Nat_Cell_Max
        sj = Mod(lookup_host(j-1),Nat_Cell_Max)
        xi = Sphere_Cell(ci*Nat_Cell_Max*(ndim+4)+si*(ndim+4): &
                         ci*Nat_Cell_Max*(ndim+4)+si*(ndim+4)+2)
        xj = Sphere_Cell(cj*Nat_Cell_Max*(ndim+4)+sj*(ndim+4): &
                         cj*Nat_Cell_Max*(ndim+4)+sj*(ndim+4)+2)
        Write(error_unit,*) 'Cluster edge IDs/cells/slots:', i, j, ci, si, cj, sj
        Write(error_unit,*) 'Cluster edge fractional coordinates:', &
                             r((i-1)*ndim:(i-1)*ndim+2), r((j-1)*ndim:(j-1)*ndim+2)
        Write(error_unit,*) 'Cluster edge cell coordinates:', xi, xj
        If (ci == cj) Then
            dx = xj-xi
            physical = [h(0)*dx(1)+h(1)*dx(2)+h(2)*dx(3), &
                        h(3)*dx(1)+h(4)*dx(2)+h(5)*dx(3), &
                        h(6)*dx(1)+h(7)*dx(2)+h(8)*dx(3)]
            Write(error_unit,*) 'Cluster same-cell distance:', Sqrt(Sum(physical*physical))
        End If
        Do n = 0, 25
            neighbor_cell = Map_Cell(ci*26+n)
            If (neighbor_cell /= cj) Cycle
            shift = DR_Cell(ci*26*ndim+n*ndim:ci*26*ndim+n*ndim+2)
            dx = xj+shift-xi
            physical = [h(0)*dx(1)+h(1)*dx(2)+h(2)*dx(3), &
                        h(3)*dx(1)+h(4)*dx(2)+h(5)*dx(3), &
                        h(6)*dx(1)+h(7)*dx(2)+h(8)*dx(3)]
            Write(error_unit,*) 'Cluster mapped-cell neighbor/shift/distance:', n, shift, Sqrt(Sum(physical*physical))
        End Do
    End Subroutine diagnose_cluster_edge

    Subroutine validate_cluster_cell_list(istep)
        Integer, Intent(In) :: istep
        Integer :: seen(natoms), icell, slot, particle, total
        seen = 0
        total = 0
        Do icell = 0, Ntot_Cell-1
            If (Nat_Cell(icell) < 0 .Or. Nat_Cell(icell) > Nat_Cell_Max) Then
                Write(error_unit,*) 'Cluster cell occupancy invalid: step/cell/count', istep, icell, Nat_Cell(icell)
                Error Stop 'Cluster cell occupancy invalid'
            End If
            Do slot = 0, Nat_Cell(icell)-1
                particle = List_Cell(icell*Nat_Cell_Max*2+slot*2)
                If (particle < 0 .Or. particle >= natoms) Then
                    Write(error_unit,*) 'Cluster cell particle ID invalid: step/cell/slot/id', &
                                         istep, icell, slot, particle
                    Error Stop 'Cluster cell particle ID invalid'
                End If
                seen(particle+1) = seen(particle+1)+1
                total = total+1
            End Do
        End Do
        If (total /= natoms .Or. Any(seen /= 1)) Then
            Write(error_unit,*) 'Cluster cell list invalid: step/total/natoms', istep, total, natoms
            Do particle = 1, natoms
                If (seen(particle) /= 1) Write(error_unit,*) 'Cluster cell ID/multiplicity:', particle, seen(particle)
            End Do
            Error Stop 'Cluster cell list invalid'
        End If
    End Subroutine validate_cluster_cell_list

    Subroutine validate_cluster_graph_cpu(istep, mask)
        Integer, Intent(In) :: istep, mask(natoms)
        Integer :: i, j, k, expected
        Real(wp) :: dr(3), distance2
        Do i = 1, natoms
            expected = 0
            If (mask(i) /= 0) Then
                Do j = 1, natoms
                    If (j == i .Or. mask(j) == 0) Cycle
                    dr = r((j-1)*ndim:(j-1)*ndim+2)-r((i-1)*ndim:(i-1)*ndim+2)
                    dr = (dr-Anint(dr))*Box(0:2)
                    If (Sum(dr*dr) < rcl*rcl) expected = expected+1
                End Do
            End If
            If (expected /= neighbors(i)) Then
                Write(error_unit,*) 'Cluster CPU/GPU neighbor-count mismatch: step/id/cpu/gpu/filled', &
                                     istep, i, expected, neighbors(i), filled(i)
                Write(error_unit,*) 'Cluster GPU row:', adjacency(offset(i):offset(i)+neighbors(i)-1)
                Do k = offset(i), offset(i)+neighbors(i)-1
                    j = adjacency(k)
                    If (j >= 1 .And. j <= natoms) Call diagnose_cluster_edge(i, j)
                End Do
                Error Stop 'Cluster CPU/GPU neighbor-count mismatch'
            End If
            Do k = offset(i), offset(i)+neighbors(i)-1
                j = adjacency(k)
                If (j < 1 .Or. j > natoms) Then
                    Write(error_unit,*) 'Cluster GPU invalid edge: step/i/j', istep, i, j
                    Error Stop 'Cluster GPU invalid edge'
                End If
                dr = r((j-1)*ndim:(j-1)*ndim+2)-r((i-1)*ndim:(i-1)*ndim+2)
                dr = (dr-Anint(dr))*Box(0:2)
                distance2 = Sum(dr*dr)
                If (distance2 > rcl*rcl) Then
                    Write(error_unit,*) 'Cluster GPU false edge: step/i/j/distance/cutoff', &
                                         istep, i, j, Sqrt(distance2), rcl
                    Write(error_unit,*) 'Cluster GPU row:', adjacency(offset(i):offset(i)+neighbors(i)-1)
                    Error Stop 'Cluster GPU false edge'
                End If
            End Do
        End Do
    End Subroutine validate_cluster_graph_cpu

    ! Subroutine to initialize cluster mask based on selected particle types
    Subroutine get_cluster_mask(cluster_mask_host)
        Integer, Intent(OUT) :: cluster_mask_host(natoms)
        Integer :: i
        cluster_mask_host(:) = 0
        If (All(cluster_types == -1)) Then
            If (pot_int == 2) Then
                Do i = 1, natoms
                    If (itype(i-1) == 1 .Or. itype(i-1) == 3) Then
                        cluster_mask_host(i) = 1
                    End If
                End Do
                If (All(cluster_mask_host == 0)) Then
                    cluster_mask_host(:) = 1
                End If
            Else
                cluster_mask_host(:) = 1
            End If
        Else
            Do i = 1, natoms
                If (Any(cluster_types == itype(i-1)) .Or. Any(cluster_types == itype(i-1) + 1)) Then
                    cluster_mask_host(i) = 1
                End If
            End Do
        End If
    End Subroutine get_cluster_mask

    Subroutine run_cluster_analysis(istep)
        Use rundata, only : istep_ini, istep_fin
        Integer, Intent(IN) :: istep
        Integer :: i, k, nb, cluster_id, size_max, nclustered, ncenters, indx, indxq, type_cl
        Integer :: queue(natoms), head, tail, curr
        Integer :: cluster_mask_host(natoms)
        Integer :: count_cl(natoms)
        Logical :: file_exists
        Real(wp) :: pct
        Integer :: io_lastclconf = 112, io_lastbrdconf = 113, nbrd, id, indx_i, indx_j, maxcolor = 32
        Real(wp), Allocatable :: asym(:)
        Logical, Allocatable :: is_border(:)
        Real(wp), Allocatable :: atom_energies_host(:)
        Integer, Allocatable :: nbrd_in_cl(:)
        Real(wp) :: S(3), xi, yi, zi, dx, dy, dz, dx_real, dy_real, dz_real, dist
        Real(wp) :: e_sum, e_avg, thresh_val
        Integer :: count_cluster_atoms
        
        ! 1. Allocate memory if needed
        Call clusters_alloc()
        cluster_diagnostic_step = istep
        If (avbmc .And. .Not. avbmc_graph_checks_initialized) Call avbmc_initialize_graph_checks()
        If (avbmc_graph_checks .And. istep >= avbmc_graph_check_from_step) &
            Call validate_cluster_cell_list(istep)
        
        ! 2. Initialize cluster mask based on selected types
        Call get_cluster_mask(cluster_mask_host)
        gcluster_mask(1:natoms) = cluster_mask_host(1:natoms)
        
        ! 3. Configure grid block
        nthread = 256
        nbcuda = (natoms + nthread - 1)/nthread
        
        ! 4. Search for neighbors and build adjacency list
        Call neighbor_search(natoms)
        If (avbmc_graph_checks .And. istep >= avbmc_graph_check_from_step) &
            Call validate_cluster_graph_cpu(istep, cluster_mask_host)
        
        ! 5. Run DBSCAN BFS search on Host (fast queue BFS on adjacency list)
        label(:) = 0
        cluster_id = 0
        
        Do i = 1, natoms
            If (cluster_mask_host(i) == 0) Cycle
            If (neighbors(i) < minPts - 1) Cycle
            If (label(i) /= 0) Cycle
            
            cluster_id = cluster_id + 1
            label(i) = cluster_id
            
            head = 1
            tail = 1
            queue(1) = i
            
            Do While (head <= tail)
                curr = queue(head)
                head = head + 1
                
                If (neighbors(curr) >= minPts - 1) Then
                    Do k = offset(curr), offset(curr) + neighbors(curr) - 1
                        nb = adjacency(k)
                        If (label(nb) == 0) Then
                            label(nb) = cluster_id
                            tail = tail + 1
                            queue(tail) = nb
                        End If
                    End Do
                End If
            End Do
        End Do
        
        ! 6. Analyze cluster size distribution
        count_cl(:) = 0
        Do i = 1, natoms
            If (label(i) > 0) Then
                count_cl(label(i)) = count_cl(label(i)) + 1
            End If
        End Do
        
        nclustered = 0
        size_max = 0
        Do i = 1, cluster_id
            If (count_cl(i) > 0) Then
                nclustered = nclustered + count_cl(i)
                If (count_cl(i) > size_max) Then
                    size_max = count_cl(i)
                End If
            End If
        End Do
        
        ncenters = Count(cluster_mask_host > 0)
        If (ncenters > 0) Then
            pct = (Real(nclustered, wp)/Real(ncenters, wp)) * 100.0_wp
        Else
            pct = 0.0_wp
        End If
        
        last_nclusters = cluster_id
        last_max_size = size_max
        last_pct_clustered = pct
            
        Inquire(File=clusevol_filename, Exist=file_exists)
        If (.Not. file_exists .Or. istep == istep_ini) Then
            Open(io_clusevol_file, File=clusevol_filename, Status='unknown')
            Write(io_clusevol_file, '(A)') '# step  n_clusters  max_size  n_clustered  pct_clustered'
        Else
            Open(io_clusevol_file, File=clusevol_filename, Status='unknown', Position='append')
        End If
        
        Write(io_clusevol_file, '(i10, i12, i10, i13, f15.4)') &
            istep, cluster_id, size_max, nclustered, pct
        Close(io_clusevol_file)

        ! 8. Write last cluster configuration to mclast_clconf.lammpstrj
        open(io_lastclconf, file='mclast_clconf.lammpstrj', status='unknown')
        write(io_lastclconf, '(A)') 'ITEM: TIMESTEP'
        write(io_lastclconf, '(I12)') istep
        write(io_lastclconf, '(A)') 'ITEM: NUMBER OF ATOMS'
        write(io_lastclconf, '(I12)') nclustered
        write(io_lastclconf, '(A)') 'ITEM: BOX BOUNDS pp pp pp'
        write(io_lastclconf, '(2F15.7)') 0.0_wp, Box(0)
        write(io_lastclconf, '(2F15.7)') 0.0_wp, Box(1)
        write(io_lastclconf, '(2F15.7)') 0.0_wp, Box(2)
        
        If (pot_int < 1) Then
            write(io_lastclconf, '(A)') 'ITEM: ATOMS id mol type x y z'
        Else
            write(io_lastclconf, '(A)') 'ITEM: ATOMS id mol type x y z quatw quati quatj quatk'
        End If
        
        do i = 1, natoms
            if (label(i) > 0) then
                indx = (i - 1) * ndim
                type_cl = 1 + mod(count_cl(label(i)), maxcolor)
                If (pot_int < 1) Then
                    write(io_lastclconf, '(I8,x,I8,x,I4,x,3F16.8)') &
                        i, label(i), type_cl, &
                        r(indx) * Box(0), r(indx + 1) * Box(1), r(indx + 2) * Box(2)
                Else
                    indxq = (i - 1) * 4
                    write(io_lastclconf, '(I8,x,I8,x,I4,x,3F16.8,x,4F16.8)') &
                        i, label(i), type_cl, &
                        r(indx) * Box(0), r(indx + 1) * Box(1), r(indx + 2) * Box(2), &
                        q(indxq), q(indxq + 1), q(indxq + 2), q(indxq + 3)
                End If
            end if
        end do
        close(io_lastclconf)

        ! 9. Compute border points using chosen criterion (asymmetry or per-atom energy)
        Allocate(is_border(natoms))
        is_border(:) = .false.

        If (avbmc .and. size_max <= cluster_threshold) Then
            ! Small-cluster regime (max cluster size <= cluster_threshold):
            ! All bound particles (neighbors >= bound_min_neighbors) are considered on the surface.
            ! Completely bypass asymmetry and per-atom energy calculations.
            Do i = 1, natoms
                If (cluster_mask_host(i) == 1 .and. neighbors(i) >= bound_min_neighbors) Then
                    is_border(i) = .true.
                End If
            End Do
        Else
            If (trim(border_criterion) == 'energy') Then
                Allocate(atom_energies_host(0:natoms-1))
                Call compute_per_atom_energy_gpu(pot_int, bool_tor, ndim, Nat_cell_max, Ntot_Cell, Npart_types, &
                   Nrb_sites_max, Ntor_max, sigma_tor_jon, sigp_factor, Rcp_factor, Rc_factor, natoms, atom_energies_host)
                
                If (use_energy_ratio) Then
                    e_sum = 0.0_wp
                    count_cluster_atoms = 0
                    Do i = 1, natoms
                        If (label(i) > 0) Then
                            e_sum = e_sum + atom_energies_host(i-1)
                            count_cluster_atoms = count_cluster_atoms + 1
                        End If
                    End Do
                    If (count_cluster_atoms > 0) Then
                        e_avg = e_sum / Real(count_cluster_atoms, wp)
                    Else
                        e_avg = 0.0_wp
                    End If
                    thresh_val = energy_border_ratio * e_avg
                Else
                    thresh_val = energy_threshold
                End If

                Do i = 1, natoms
                    If (label(i) > 0 .And. atom_energies_host(i-1) >= thresh_val) Then
                        is_border(i) = .true.
                    End If
                End Do
                Deallocate(atom_energies_host)

            Else
                ! Default: Geometric asymmetry criterion (normalized net neighbor vector magnitude)
                Allocate(asym(natoms))
                asym(:) = 0.0_wp
                
                Do i = 1, natoms
                    If (label(i) > 0 .And. neighbors(i) > 0) Then
                        S(1) = 0.0_wp; S(2) = 0.0_wp; S(3) = 0.0_wp
                        indx_i = (i - 1) * ndim
                        xi = r(indx_i)
                        yi = r(indx_i + 1)
                        zi = r(indx_i + 2)
                        
                        Do k = offset(i), offset(i) + neighbors(i) - 1
                            id = adjacency(k)
                            indx_j = (id - 1) * ndim
                            dx = r(indx_j) - xi
                            dy = r(indx_j + 1) - yi
                            dz = r(indx_j + 2) - zi
                            
                            dx = dx - anint(dx)
                            dy = dy - anint(dy)
                            dz = dz - anint(dz)
                            
                            dx_real = dx * Box(0)
                            dy_real = dy * Box(1)
                            dz_real = dz * Box(2)
                            
                            dist = Sqrt(dx_real**2 + dy_real**2 + dz_real**2)
                            If (dist > 0.0_wp) Then
                                S(1) = S(1) + dx_real / dist
                                S(2) = S(2) + dy_real / dist
                                S(3) = S(3) + dz_real / dist
                            End If
                        End Do
                        asym(i) = Sqrt(S(1)**2 + S(2)**2 + S(3)**2) / Real(neighbors(i), wp)
                    End If
                End Do

                Do i = 1, natoms
                    If (label(i) > 0 .And. asym(i) >= asym_threshold) Then
                        is_border(i) = .true.
                    End If
                End Do
                Deallocate(asym)
            End If
        End If

        Allocate(nbrd_in_cl(Max(1, cluster_id)))
        nbrd_in_cl(:) = 0
        nbrd = 0
        Do i = 1, natoms
            If (is_border(i)) Then
                nbrd = nbrd + 1
                If (label(i) > 0) Then
                    nbrd_in_cl(label(i)) = nbrd_in_cl(label(i)) + 1
                End If
            End If
        End Do
        
        ! 10. Write last border configuration to mclast_brdconf.lammpstrj
        open(io_lastbrdconf, file='mclast_brdconf.lammpstrj', status='unknown')
        write(io_lastbrdconf, '(A)') 'ITEM: TIMESTEP'
        write(io_lastbrdconf, '(I12)') istep
        write(io_lastbrdconf, '(A)') 'ITEM: NUMBER OF ATOMS'
        write(io_lastbrdconf, '(I12)') nbrd
        write(io_lastbrdconf, '(A)') 'ITEM: BOX BOUNDS pp pp pp'
        write(io_lastbrdconf, '(2F15.7)') 0.0_wp, Box(0)
        write(io_lastbrdconf, '(2F15.7)') 0.0_wp, Box(1)
        write(io_lastbrdconf, '(2F15.7)') 0.0_wp, Box(2)
        
        If (pot_int < 1) Then
            write(io_lastbrdconf, '(A)') 'ITEM: ATOMS id mol type x y z'
        Else
            write(io_lastbrdconf, '(A)') 'ITEM: ATOMS id mol type x y z quatw quati quatj quatk'
        End If
        
        do i = 1, natoms
            if (is_border(i)) then
                indx = (i - 1) * ndim
                If (label(i) > 0) Then
                    type_cl = 1 + mod(nbrd_in_cl(label(i)), maxcolor)
                Else
                    type_cl = 1
                End If
                If (pot_int < 1) Then
                    write(io_lastbrdconf, '(I8,x,I8,x,I4,x,3F16.8)') &
                        i, label(i), type_cl, &
                        r(indx) * Box(0), r(indx + 1) * Box(1), r(indx + 2) * Box(2)
                Else
                    indxq = (i - 1) * 4
                    write(io_lastbrdconf, '(I8,x,I8,x,I4,x,3F16.8,x,4F16.8)') &
                        i, label(i), type_cl, &
                        r(indx) * Box(0), r(indx + 1) * Box(1), r(indx + 2) * Box(2), &
                        q(indxq), q(indxq + 1), q(indxq + 2), q(indxq + 3)
                End If
            end if
        end do
        close(io_lastbrdconf)
        
        Deallocate(nbrd_in_cl)
        Deallocate(is_border)
        
    End Subroutine run_cluster_analysis

    Subroutine cpu_graf_cell(Sphere_Cell, List_Cell, Map_Cell, Nat_Cell, DR_Cell, &
                             Lookup, Nat_Cell_Max, Ntot_Cell, Nsites, dim, rcl2, h, mask, neighbors_cpu)
        Implicit None
        Integer, Intent(IN) :: Nat_Cell_Max, Ntot_Cell, Nsites, dim
        Real(wp) :: rcl2
        real(wp), intent(in) :: Sphere_Cell(0:*), DR_Cell(0:*), h(0:*)
        integer, intent(in) :: List_Cell(0:*), Map_Cell(0:*), Nat_Cell(0:*)
        integer, intent(in) :: Lookup(0:*)
        integer, intent(in) :: mask(Nsites)
        integer, intent(out) :: neighbors_cpu(Nsites)
        
        integer :: i, cell_offset, icell, j_offset, counter, jcell, k, kpart, n, nneigh
        real(wp) :: xi, yi, zi, xj, yj, zj, dx, dy, dz, dxp, dyp, dzp, rr2
        real(wp) :: dx_shift, dy_shift, dz_shift
        
        do i = 1, Nsites
            neighbors_cpu(i) = 0
            If (mask(i) == 0) cycle
            
            counter = 0
            cell_offset = Lookup(i-1)
            icell = cell_offset / Nat_Cell_Max
            j_offset = mod(cell_offset, Nat_Cell_Max)
            
            xi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4))
            yi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4) + 1)
            zi = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + j_offset * (dim + 4) + 2)
            
            ! 1. Check particles in same cell
            do k = 0, Nat_Cell(icell) - 1
                kpart = List_Cell(icell * Nat_Cell_Max * 2 + k * 2)
                if (i-1 /= kpart .and. mask(kpart+1) /= 0) then
                    xj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4))
                    yj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 1)
                    zj = Sphere_Cell(icell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 2)
                    dx = xj - xi
                    dy = yj - yi
                    dz = zj - zi
                    dxp = h(0)*dx + h(1)*dy + h(2)*dz
                    dyp = h(3)*dx + h(4)*dy + h(5)*dz
                    dzp = h(6)*dx + h(7)*dy + h(8)*dz
                    rr2 = dxp*dxp + dyp*dyp + dzp*dzp
                    if (rr2 <= rcl2) then
                        counter = counter + 1
                    end if
                end if
            end do
            
            ! 2. Check particles in neighbor cells
            if (dim == 3) then
                nneigh = 26
            else
                nneigh = 8
            endif
            
            do n = 0, nneigh - 1
                jcell = Map_Cell(icell * nneigh + n)
                dx_shift = DR_Cell(icell * nneigh * dim + n * dim)
                dy_shift = DR_Cell(icell * nneigh * dim + n * dim + 1)
                dz_shift = 0.0_wp
                if (dim == 3) dz_shift = DR_Cell(icell * nneigh * dim + n * dim + 2)
                
                do k = 0, Nat_Cell(jcell) - 1
                    kpart = List_Cell(jcell * Nat_Cell_Max * 2 + k * 2)
                    if (mask(kpart+1) /= 0) then
                        xj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4)) + dx_shift
                        yj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 1) + dy_shift
                        zj = Sphere_Cell(jcell * Nat_Cell_Max * (dim + 4) + k * (dim + 4) + 2) + dz_shift
                        dx = xj - xi
                        dy = yj - yi
                        dz = zj - zi
                        dxp = h(0)*dx + h(1)*dy + h(2)*dz
                        dyp = h(3)*dx + h(4)*dy + h(5)*dz
                        dzp = h(6)*dx + h(7)*dy + h(8)*dz
                        rr2 = dxp*dxp + dyp*dyp + dzp*dzp
                        if (rr2 <= rcl2) then
                            counter = counter + 1
                        end if
                    end if
                end do
            end do
            
            neighbors_cpu(i) = counter
        enddo
    End Subroutine cpu_graf_cell

END MODULE mod_clusters
