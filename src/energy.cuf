! ==============================================================================
! CPU ROUTINE: calculate_patchy_energy_angular (pot_int == 1)
! ==============================================================================
Subroutine calculate_patchy_energy_angular(itypei, itypej, r12, rsq, dxp, dyp, dzp, &
                                   Q10, Q11, Q12, Q13, Q20, Q21, Q22, Q23, &
                                   sigma_LJ_aux, eps_LJ_aux, xop_aux, vl0_aux, en_patchy)
    Use set_precision
    Use configuration
    Use potential
    Use potential_functions, only: vpatch_angular, vlj, eval_table_pot_host
    Implicit None

    Integer, Intent(In)  :: itypei, itypej
    Real(wp), Intent(In) :: r12, rsq, dxp, dyp, dzp
    Real(wp), Intent(In) :: Q10, Q11, Q12, Q13, Q20, Q21, Q22, Q23
    Real(wp), Intent(In) :: sigma_LJ_aux, eps_LJ_aux, xop_aux, vl0_aux
    Real(wp), Intent(Out) :: en_patchy

    Real(wp) :: Q102, Q112, Q122, Q132, Q10Q11, Q10Q12, Q10Q13, Q11Q12, Q11Q13, Q12Q13
    Real(wp) :: R111, R112, R113, R121, R122, R123, R131, R132, R133
    Real(wp) :: Q202, Q212, Q222, Q232, Q20Q21, Q20Q22, Q20Q23, Q21Q22, Q21Q23, Q22Q23
    Real(wp) :: R211, R212, R213, R221, R222, R223, R231, R232, R233
    Real(wp) :: R1(0:8), R2(0:8), Vangtor_max, VRAD, FX, FXI, pi, dospi, a

    pi = acos(-1.d0); dospi = 2.d0*pi; a = 1000.d0  

    Q102=Q10*Q10; Q112=Q11*Q11; Q122=Q12*Q12; Q132=Q13*Q13
    Q10Q11=Q10*Q11; Q10Q12=Q10*Q12; Q10Q13=Q10*Q13; Q11Q12=Q11*Q12; Q11Q13=Q11*Q13; Q12Q13=Q12*Q13
    R111=Q102+Q112-Q122-Q132;    R112=2.d00*(Q11Q12-Q10Q13); R113=2.d00*(Q11Q13+Q10Q12)
    R121=2.d00*(Q11Q12+Q10Q13); R122=Q102-Q112+Q122-Q132;    R123=2.d00*(Q12Q13-Q10Q11)
    R131=2.d00*(Q11Q13-Q10Q12); R132=2.d00*(Q12Q13+Q10Q11); R133=Q102-Q112-Q122+Q132

    Q202=Q20*Q20; Q212=Q21*Q21; Q222=Q22*Q22; Q232=Q23*Q23
    Q20Q21=Q20*Q21; Q20Q22=Q20*Q22; Q20Q23=Q20*Q23; Q21Q22=Q21*Q22; Q21Q23=Q21*Q23; Q22Q23=Q22*Q23
    R211=Q202+Q212-Q222-Q232;    R212=2.d00*(Q21Q22-Q20Q23); R213=2.d00*(Q21Q23+Q20Q22)
    R221=2.d00*(Q21Q22+Q20Q23); R222=Q202-Q212+Q222-Q232;    R223=2.d00*(Q22Q23-Q20Q21)
    R231=2.d00*(Q21Q23-Q20Q22); R232=2.d00*(Q22Q23+Q20Q21); R233=Q202-Q212-Q222+Q232

    R1(0)=R111; R1(1)=R112; R1(2)=R113
    R1(3)=R121; R1(4)=R122; R1(5)=R123
    R1(6)=R131; R1(7)=R132; R1(8)=R133

    R2(0)=R211; R2(1)=R212; R2(2)=R213
    R2(3)=R221; R2(4)=R222; R2(5)=R223
    R2(6)=R231; R2(7)=R232; R2(8)=R233

    call vpatch_angular(dxp, dyp, dzp, r12, &
         R1, R2, bool_tor, Npart_types, Nrb_sites_max, Ndim, Ntor_max, a, pi, dospi, sigma_tor_jon, &
         Nrb_sites, PATCH, sigma_jon, Vpot_matrix, Ntor_angle, tor_angle, &
         itypei, itypej, Vangtor_max)

    If (Vangtor_max == -1.d00) then
        en_patchy = 0.0 
    Else 
        FX  = (1.d0 + Tanh(a * (-xop_aux + r12))) / 2.d00
        FXI = (1.d0 - Tanh(a * (-xop_aux + r12))) / 2.d00
        if (table_mc .and. has_table(itypei, itypej)) then
            call eval_table_pot_host(r12, itypei, itypej, VRAD)
        else
            call vlj(rsq, sigma_LJ_aux, eps_LJ_aux, vl0_aux, VRAD)
        end if
        en_patchy = VRAD * (FXI + Vangtor_max * FX) 
    End If
End Subroutine calculate_patchy_energy_angular

! ==============================================================================
! CPU ROUTINE: calculate_patchy_energy_sitesite (pot_int == 2)
! ==============================================================================
Subroutine calculate_patchy_energy_sitesite(itypei, itypej, dxp, dyp, dzp, &
                                   Q10, Q11, Q12, Q13, Q20, Q21, Q22, Q23, &
                                   sigma_LJ_aux, en_patches)
   Use set_precision
   Use configuration
   Use potential
   Use potential_functions, only: vpatch_sitesite_host
   Implicit None

   Integer, Intent(In)  :: itypei, itypej
   Real(wp), Intent(In) :: dxp, dyp, dzp
   Real(wp), Intent(In) :: Q10, Q11, Q12, Q13, Q20, Q21, Q22, Q23
   Real(wp), Intent(In) :: sigma_LJ_aux
   Real(wp), Intent(Out) :: en_patches

   Real(wp) :: Q102, Q112, Q122, Q132, Q10Q11, Q10Q12, Q10Q13, Q11Q12, Q11Q13, Q12Q13
   Real(wp) :: R111, R112, R113, R121, R122, R123, R131, R132, R133
   Real(wp) :: Q202, Q212, Q222, Q232, Q20Q21, Q20Q22, Q20Q23, Q21Q22, Q21Q23, Q22Q23
   Real(wp) :: R211, R212, R213, R221, R222, R223, R231, R232, R233
   Real(wp) :: R1(0:8), R2(0:8)

   Q102=Q10*Q10; Q112=Q11*Q11; Q122=Q12*Q12; Q132=Q13*Q13
   Q10Q11=Q10*Q11; Q10Q12=Q10*Q12; Q10Q13=Q10*Q13; Q11Q12=Q11*Q12; Q11Q13=Q11*Q13; Q12Q13=Q12*Q13
   R111=Q102+Q112-Q122-Q132;    R112=2.d00*(Q11Q12-Q10Q13); R113=2.d00*(Q11Q13+Q10Q12)
   R121=2.d00*(Q11Q12+Q10Q13); R122=Q102-Q112+Q122-Q132;    R123=2.d00*(Q12Q13-Q10Q11)
   R131=2.d00*(Q11Q13-Q10Q12); R132=2.d00*(Q12Q13+Q10Q11); R133=Q102-Q112-Q122+Q132

   Q202=Q20*Q20; Q212=Q21*Q21; Q222=Q22*Q22; Q232=Q23*Q23
   Q20Q21=Q20*Q21; Q20Q22=Q20*Q22; Q20Q23=Q20*Q23; Q21Q22=Q21*Q22; Q21Q23=Q21*Q23; Q22Q23=Q22*Q23
   R211=Q202+Q212-Q222-Q232;    R212=2.d00*(Q21Q22-Q20Q23); R213=2.d00*(Q21Q23+Q20Q22)
   R221=2.d00*(Q21Q22+Q20Q23); R222=Q202-Q212+Q222-Q232;    R223=2.d00*(Q22Q23-Q20Q21)
   R231=2.d00*(Q21Q23-Q20Q22); R232=2.d00*(Q22Q23+Q20Q21); R233=Q202-Q212-Q222+Q232

   R1(0)=R111; R1(1)=R112; R1(2)=R113
   R1(3)=R121; R1(4)=R122; R1(5)=R123
   R1(6)=R131; R1(7)=R132; R1(8)=R133

   R2(0)=R211; R2(1)=R212; R2(2)=R213
   R2(3)=R221; R2(4)=R222; R2(5)=R223
   R2(6)=R231; R2(7)=R232; R2(8)=R233

    call vpatch_sitesite_host(dxp, dyp, dzp, R1, R2, sigp_factor, Rcp_factor, patch_radial_factor, &
          itypei, itypej, Npart_types, Nrb_sites_max, Ndim, &
          Nrb_sites, PATCH, sigma_LJ, Vpot_Matrix, en_patches)
End Subroutine calculate_patchy_energy_sitesite

! ==============================================================================
! CPU ROUTINE: ener (Master Router)
! ==============================================================================
Subroutine ener(i1, i2, en, overlap)
      Use set_precision
      Use configuration
      Use potential
      Use rundata        
      Use potential_functions, only: vlj, vlj_palaia, eval_table_pot_host
      Implicit None
      
      Integer, Intent(In)   :: i1, i2
      Real(wp), Intent(Out) :: en
      Logical, Intent(Out)  :: overlap

      Integer  :: Indxi, Indxj, itypei, itypej, Indx
      Real(wp) :: X1, Y1, Z1, X2, Y2, Z2, DX, DY, DZ, DXP, DYP, DZP, RSQ, R12
      Real(wp) :: Q10, Q11, Q12, Q13, Q20, Q21, Q22, Q23
      Real(wp) :: sigma_LJ_aux, eps_LJ_aux, xop_aux, vl0_aux, rangep_aux
      Real(wp) :: en_patches

      en = 0.0_wp
      overlap = .False.

      Indxi = i1*Ndim
      X1 = R(Indxi);   Y1 = R(Indxi+1); Z1 = R(Indxi+2)
      Indxi = i1*4
      Q10 = q(Indxi); Q11 = q(Indxi+1); Q12 = q(Indxi+2); Q13 = q(Indxi+3)
      itypei = itype(i1)

      Indxj = i2*Ndim
      X2 = R(Indxj);   Y2 = R(Indxj+1); Z2 = R(Indxj+2)
      Indxj = i2*4
      Q20 = q(Indxj); Q21 = q(Indxj+1); Q22 = q(Indxj+2); Q23 = q(Indxj+3)
      itypej = itype(i2)

      DX = X2 - X1; DY = Y2 - Y1; DZ = Z2 - Z1
      DX = DX - NINT(DX); DY = DY - NINT(DY); DZ = DZ - NINT(DZ)
 
      DXP = H(0)*DX + H(1)*DY + H(2)*DZ
      DYP = H(3)*DX + H(4)*DY + H(5)*DZ
      DZP = H(6)*DX + H(7)*DY + H(8)*DZ
 
      RSQ = DXP**2.0 + DYP**2.0 + DZP**2.0
      R12 = SQRT(RSQ)

      Indx = itypei*Npart_types+itypej
      sigma_LJ_aux = sigma_LJ(Indx)
      eps_LJ_aux   = epsilon_LJ(Indx)
      xop_aux      = xop(Indx)
      vl0_aux      = vl0(Indx)
      rangep_aux   = rangep(Indx)

      IF (table_mc .and. has_table(itypei, itypej)) THEN
          IF (R12 < table_rmin(itypei, itypej)) THEN
              overlap = .True.
              en = 9.e+33_wp  
              Return
          ELSEIF (R12 < rangep_aux) THEN
              call eval_table_pot_host(R12, itypei, itypej, en)
              if (en > 1.0e30_wp) overlap = .True.
          END IF
      ELSE
          IF (R12 < 0.5_wp) THEN
              overlap = .True.
              en = 9.e+33_wp  
              Return
          ELSEIF (R12 < rangep_aux) THEN
              If (pot_int == 2) then
                  ! Site-Site uses Palaia WCA + Cosine Tail. 
                  ! We pass vl0_aux as the 'epsp' patch depth parameter.
                  Call vlj_palaia(RSQ, sigma_LJ_aux, eps_LJ_aux, vl0_aux, Rc_factor, en)
              Else if (pot_int == 1) then
                  Call vlj(RSQ, sigma_LJ_aux, eps_LJ_aux, vl0_aux, en)
              endif
          END IF
      END IF
      If (NRB_SITES(itypei) > 0 .and. NRB_SITES(itypej) > 0) then
          If (pot_int == 1) then
              Call calculate_patchy_energy_angular(itypei, itypej, r12, rsq, dxp, dyp, dzp, &
                                           Q10, Q11, Q12, Q13, Q20, Q21, Q22, Q23, &
                                           sigma_LJ_aux, eps_LJ_aux, xop_aux, vl0_aux, en)
          Else if (pot_int == 2) then
              Call calculate_patchy_energy_sitesite(itypei, itypej, dxp, dyp, dzp, &
                                           Q10, Q11, Q12, Q13, Q20, Q21, Q22, Q23, &
                                           sigma_LJ_aux, en_patches)
              en = en + en_patches
          End If
      End If 
END Subroutine ener

! ==============================================================================
! CPU ROUTINE: ener_LJ
! ==============================================================================
Subroutine ener_LJ(i1, i2, en, overlap)
   Use set_precision
   Use configuration
   Use potential
   Use potential_functions, only: vlj, eval_table_pot_host
   Implicit None
   
   Integer, Intent(in)   :: i1, i2
   Real(wp), Intent(out) :: en
   Logical, Intent(out)  :: overlap
   
   Integer  :: itypei, itypej, Indx, Indxi, Indxj
   Real(wp) :: X1, Y1, Z1, X2, Y2, Z2, DX, DY, DZ
   Real(wp) :: DXP, DYP, DZP, RSQ, R12
   Real(wp) :: sigma_LJ_aux, eps_LJ_aux, rangep_aux, vl0_aux

   Indxi = I1 * Ndim
   X1 = r(Indxi); Y1 = r(Indxi+1); Z1 = r(Indxi+2)
   itypei = itype(I1)

   Indxj = I2 * Ndim
   X2 = r(Indxj); Y2 = r(Indxj+1); Z2 = r(Indxj+2)
   itypej = itype(I2)

   DX = X2 - X1; DY = Y2 - Y1; DZ = Z2 - Z1
   DX = DX - NINT(DX)  
   DY = DY - NINT(DY)
   DZ = DZ - NINT(DZ)

   DXP = H(0)*DX + H(1)*DY + H(2)*DZ
   DYP = H(3)*DX + H(4)*DY + H(5)*DZ
   DZP = H(6)*DX + H(7)*DY + H(8)*DZ

   RSQ = DXP**2.0_wp + DYP**2.0_wp + DZP**2.0_wp
   R12 = SQRT(RSQ)

   en = 0.0_wp
   overlap = .false.
   Indx = itypei * Npart_types + itypej
   sigma_LJ_aux = sigma_LJ(Indx)
   eps_LJ_aux   = epsilon_LJ(Indx)
   rangep_aux   = rangep(Indx)
   vl0_aux      = vl0(Indx)       

   IF (table_mc .and. has_table(itypei, itypej)) THEN
        IF (R12 < table_rmin(itypei, itypej)) THEN
             en = 9.e+33_wp
             overlap = .true.
        ELSEIF (R12 < rangep_aux) THEN
             call eval_table_pot_host(R12, itypei, itypej, en)
             if (en > 1.0e30_wp) overlap = .true.
        END IF
   ELSE
        IF (R12 < 0.5_wp) THEN
             en = 9.e+33_wp
             overlap = .true.
        ELSEIF (R12 < rangep_aux) THEN
             call vlj(RSQ, sigma_LJ_aux, eps_LJ_aux, vl0_aux, en)
        END IF
   END IF
End Subroutine ener_LJ

! ==============================================================================
! CPU ROUTINE: ener_HS (Hard Sphere pair, possibly non-additive mixture)
! DESCRIPTION: Athermal contact interaction. The energy is zero unless the two
! spheres overlap (center-center distance below the pair diameter sigma_ij), in
! which case the configuration is forbidden. Used only for CPU verification of
! the initial/final configuration.
! ==============================================================================
Subroutine ener_HS(i1, i2, en, overlap)
   Use set_precision
   Use configuration
   Use potential
   Implicit None

   Integer, Intent(in)   :: i1, i2
   Real(wp), Intent(out) :: en
   Logical, Intent(out)  :: overlap

   Integer  :: itypei, itypej, Indx, Indxi, Indxj
   Real(wp) :: X1, Y1, Z1, X2, Y2, Z2, DX, DY, DZ
   Real(wp) :: DXP, DYP, DZP, RSQ, sigma_HS_aux

   Indxi = I1 * Ndim
   X1 = r(Indxi); Y1 = r(Indxi+1); Z1 = r(Indxi+2)
   itypei = itype(I1)

   Indxj = I2 * Ndim
   X2 = r(Indxj); Y2 = r(Indxj+1); Z2 = r(Indxj+2)
   itypej = itype(I2)

   DX = X2 - X1; DY = Y2 - Y1; DZ = Z2 - Z1
   DX = DX - NINT(DX)
   DY = DY - NINT(DY)
   DZ = DZ - NINT(DZ)

   DXP = H(0)*DX + H(1)*DY + H(2)*DZ
   DYP = H(3)*DX + H(4)*DY + H(5)*DZ
   DZP = H(6)*DX + H(7)*DY + H(8)*DZ

   RSQ = DXP**2.0_wp + DYP**2.0_wp + DZP**2.0_wp

   en = 0.0_wp
   overlap = .false.
   Indx = itypei * Npart_types + itypej
   sigma_HS_aux = sigma_LJ(Indx)

   IF (RSQ < sigma_HS_aux*sigma_HS_aux) THEN
        en = 9.e+33_wp
        overlap = .true.
   END IF
End Subroutine ener_HS

! ==============================================================================
! CPU ROUTINE: Accumulate_HS_Virial_Histogram (pot_int == -1 only)
! DESCRIPTION: Accumulates pair distance counts into near-contact shells and
! accumulates simulation box volume across MC cycles within the Nsave window.
! ==============================================================================
Subroutine Accumulate_HS_Virial_Histogram()
   Use set_precision
   Use configuration
   Use potential, Only: Npart_types, sigma_LJ
   Use mod_hs_virial_accum
   Implicit None

   Integer, Parameter :: Nbins = 10
   Real(wp), Parameter :: shell_frac = 0.0025_wp

   Integer :: i, j, ti, tj, a, b, pidx, k, npairs_types_tot
   Real(wp) :: DX, DY, DZ, DXP, DYP, DZP, R12
   Real(wp) :: sigma_ab, delta_ab, Vol

   npairs_types_tot = Npart_types*(Npart_types+1)/2
   If (.not. allocated(counts_accum)) Then
      Allocate( counts_accum(0:npairs_types_tot-1, Nbins) )
      counts_accum = 0.0_wp
      Vol_accum = 0.0_wp
      nsamples_virial = 0
   End If

   ! Box volume
   Vol = h(0)*(h(4)*h(8)-h(5)*h(7)) - h(3)*(h(1)*h(8)-h(2)*h(7)) + h(6)*(h(1)*h(5)-h(2)*h(4))
   Vol_accum = Vol_accum + Vol
   nsamples_virial = nsamples_virial + 1

   ! Pairwise near-contact shell histogram (10 fine bins of width 0.0025*sigma)
   Do i = 0, Natoms-2
      ti = itype(i)
      Do j = i+1, Natoms-1
         tj = itype(j)
         a = min(ti,tj); b = max(ti,tj)
         pidx = a*Npart_types - a*(a-1)/2 + (b-a)
         sigma_ab = sigma_LJ(ti*Npart_types+tj)
         delta_ab = shell_frac * sigma_ab

         DX = R(j*Ndim)   - R(i*Ndim)
         DY = R(j*Ndim+1) - R(i*Ndim+1)
         DZ = R(j*Ndim+2) - R(i*Ndim+2)
         DX = DX - NINT(DX); DY = DY - NINT(DY); DZ = DZ - NINT(DZ)
         DXP = H(0)*DX + H(1)*DY + H(2)*DZ
         DYP = H(3)*DX + H(4)*DY + H(5)*DZ
         DZP = H(6)*DX + H(7)*DY + H(8)*DZ
         R12 = SQRT(DXP*DXP + DYP*DYP + DZP*DZP)

         If (R12 >= sigma_ab .and. R12 < sigma_ab + Nbins*delta_ab) Then
            k = int( (R12 - sigma_ab)/delta_ab ) + 1
            If (k >= 1 .and. k <= Nbins) counts_accum(pidx,k) = counts_accum(pidx,k) + 1.0_wp
         End If
      End Do
   End Do
End Subroutine Accumulate_HS_Virial_Histogram

! ==============================================================================
! CPU ROUTINE: HS_Virial_Pressure (pot_int == -1 only)
! DESCRIPTION: Computes time-averaged virial pressure from accumulated near-contact
! pair histograms and box volume over the Nsave window.
! ==============================================================================
Subroutine HS_Virial_Pressure(P_HS)
   Use set_precision
   Use configuration
   Use potential, Only: Npart_types, sigma_LJ
   Use rundata, Only: Temp
   Use mod_hs_virial_accum
   Implicit None
   Real(wp), Intent(Out) :: P_HS

   Integer, Parameter :: Nbins = 10
   Real(wp), Parameter :: shell_frac = 0.0025_wp
   Real(wp), Parameter :: pi = 3.14159265358979_wp

   Integer :: i, ti, tj, a, b, pidx, k, npairs_type, valid_bins
   Real(wp) :: sigma_ab, delta_ab, rin, rout, rmid, shellvol, Vol, xval, yval
   Real(wp) :: sumx, sumy, sumxy, sumxx, slope, intercept, denom
   Real(wp) :: g_contact, sum_term
   Integer, Allocatable :: Ntype(:)
   Real(wp), Allocatable :: rho(:), counts(:,:)

   If (nsamples_virial == 0) Then
      Call Accumulate_HS_Virial_Histogram()
   End If

   Vol = Vol_accum / dble(nsamples_virial)

   Allocate( Ntype(0:Npart_types-1) )
   Allocate( rho(0:Npart_types-1) )
   Allocate( counts(0:Npart_types*(Npart_types+1)/2-1, Nbins) )
   Ntype = 0

   counts = counts_accum / dble(nsamples_virial)

   Do i = 0, Natoms-1
      Ntype(itype(i)) = Ntype(itype(i)) + 1
   End Do

   Do a = 0, Npart_types-1
      rho(a) = dble(Ntype(a)) / Vol
   End Do

   ! Multicomponent virial sum using time-averaged counts
   sum_term = 0.0_wp
   Do a = 0, Npart_types-1
      Do b = a, Npart_types-1
         pidx = a*Npart_types - a*(a-1)/2 + (b-a)
         sigma_ab = sigma_LJ(a*Npart_types+b)
         delta_ab = shell_frac * sigma_ab

         If (a == b) Then
            npairs_type = Ntype(a)*(Ntype(a)-1)/2
         Else
            npairs_type = Ntype(a)*Ntype(b)
         End If

         ! Try Log-Linear fit (ln(g) vs r - sigma) for exponential contact peak; fallback to linear fit
         sumx = 0.0_wp; sumy = 0.0_wp; sumxy = 0.0_wp; sumxx = 0.0_wp
         valid_bins = 0
         Do k = 1, Nbins
            rin  = sigma_ab + dble(k-1)*delta_ab
            rout = sigma_ab + dble(k)*delta_ab
            rmid = 0.5_wp*(rin+rout)
            shellvol = (4.0_wp*pi/3.0_wp)*(rout**3 - rin**3)
            If (npairs_type > 0) Then
               g_contact = counts(pidx,k) / (dble(npairs_type)*shellvol/Vol)
            Else
               g_contact = 0.0_wp
            End If

            If (g_contact > 1.0e-8_wp) Then
               xval = rmid - sigma_ab
               yval = log(g_contact)
               sumx  = sumx  + xval
               sumy  = sumy  + yval
               sumxy = sumxy + xval*yval
               sumxx = sumxx + xval*xval
               valid_bins = valid_bins + 1
            End If
         End Do

         If (valid_bins >= 3) Then
            denom = dble(valid_bins)*sumxx - sumx*sumx
            If (abs(denom) > 1.0e-12_wp) Then
               intercept = (sumy*sumxx - sumx*sumxy) / denom
               g_contact = exp(intercept)
            Else
               g_contact = exp(sumy / dble(valid_bins))
            End If
         Else
            ! Standard linear fallback fit (g vs r - sigma)
            sumx = 0.0_wp; sumy = 0.0_wp; sumxy = 0.0_wp; sumxx = 0.0_wp
            Do k = 1, Nbins
               rin  = sigma_ab + dble(k-1)*delta_ab
               rout = sigma_ab + dble(k)*delta_ab
               rmid = 0.5_wp*(rin+rout)
               shellvol = (4.0_wp*pi/3.0_wp)*(rout**3 - rin**3)
               If (npairs_type > 0) Then
                  g_contact = counts(pidx,k) / (dble(npairs_type)*shellvol/Vol)
               Else
                  g_contact = 0.0_wp
               End If
               xval = rmid - sigma_ab
               sumx  = sumx  + xval
               sumy  = sumy  + g_contact
               sumxy = sumxy + xval*g_contact
               sumxx = sumxx + xval*xval
            End Do
            denom = dble(Nbins)*sumxx - sumx*sumx
            If (abs(denom) > 1.0e-12_wp) Then
               intercept = (sumy*sumxx - sumx*sumxy) / denom
               g_contact = intercept
            Else
               g_contact = sumy / dble(Nbins)
            End If
         End If

         If (g_contact < 0.0_wp) g_contact = 0.0_wp

         If (a == b) Then
            sum_term = sum_term + rho(a)*rho(a)*sigma_ab**3*g_contact
         Else
            sum_term = sum_term + 2.0_wp*rho(a)*rho(b)*sigma_ab**3*g_contact
         End If
      End Do
   End Do

   P_HS = (dble(Natoms)/Vol)*Temp + (2.0_wp*pi/3.0_wp)*Temp*sum_term

   Deallocate(Ntype, rho, counts)

   ! Reset accumulators for next Nsave window
   counts_accum = 0.0_wp
   Vol_accum = 0.0_wp
   nsamples_virial = 0
End Subroutine HS_Virial_Pressure

! ==============================================================================
! CPU ROUTINE: calc_swap_energy_cpu
! DESCRIPTION: Computes the exact energy difference Delta_E on the CPU when
! swapping the species identities of particles i1 and i2.
! Supports all interaction potentials (HS, LJ, Table, Angular, Site-Site).
! Properly accounts for non-spherically symmetric orientations and mutual pair
! energy changes between i1 and i2.
! ==============================================================================
Subroutine calc_swap_energy_cpu(i1, i2, delta_e, overlap)
   Use set_precision
   Use configuration
   Use potential
   Use rundata, Only: pot_int
   Implicit None
   Integer, Intent(in)   :: i1, i2
   Real(wp), Intent(out) :: delta_e
   Logical, Intent(out)  :: overlap

   Integer :: k, orig_type1, orig_type2
   Real(wp) :: e_old_12, e_new_12, e_old_1, e_new_1, e_old_2, e_new_2
   Logical :: ov_k

   delta_e = 0.0_wp
   overlap = .false.

   orig_type1 = itype(i1)
   orig_type2 = itype(i2)

   If (orig_type1 == orig_type2) Return

   ! 1. Evaluate mutual interaction between i1 and i2 in old configuration
   If (pot_int == -1) Then
      Call ener_HS(i1, i2, e_old_12, ov_k)
   ElseIf (pot_int < 1) Then
      Call ener_LJ(i1, i2, e_old_12, ov_k)
   Else
      Call ener(i1, i2, e_old_12, ov_k)
   EndIf
   If (ov_k) overlap = .true.

   ! 2. Evaluate mutual interaction in swapped configuration
   itype(i1) = orig_type2
   itype(i2) = orig_type1

   If (pot_int == -1) Then
      Call ener_HS(i1, i2, e_new_12, ov_k)
   ElseIf (pot_int < 1) Then
      Call ener_LJ(i1, i2, e_new_12, ov_k)
   Else
      Call ener(i1, i2, e_new_12, ov_k)
   EndIf
   If (ov_k) overlap = .true.

   If (pot_int /= -1) Then
      delta_e = delta_e + (e_new_12 - e_old_12)
   EndIf

   ! 3. Evaluate interactions with all other particles k /= i1, i2
   Do k = 0, Natoms - 1
      If (k /= i1 .and. k /= i2) Then
         ! Interactions in new swapped configuration (itype(i1)=orig_type2, itype(i2)=orig_type1)
         If (pot_int == -1) Then
            Call ener_HS(i1, k, e_new_1, ov_k)
            If (ov_k) overlap = .true.
            Call ener_HS(i2, k, e_new_2, ov_k)
            If (ov_k) overlap = .true.
         ElseIf (pot_int < 1) Then
            Call ener_LJ(i1, k, e_new_1, ov_k)
            If (ov_k) overlap = .true.
            Call ener_LJ(i2, k, e_new_2, ov_k)
            If (ov_k) overlap = .true.
         Else
            Call ener(i1, k, e_new_1, ov_k)
            If (ov_k) overlap = .true.
            Call ener(i2, k, e_new_2, ov_k)
            If (ov_k) overlap = .true.
         EndIf

         ! Interactions in old configuration: temporarily restore original types
         itype(i1) = orig_type1
         itype(i2) = orig_type2
         If (pot_int == -1) Then
            Call ener_HS(i1, k, e_old_1, ov_k)
            If (ov_k) overlap = .true.
            Call ener_HS(i2, k, e_old_2, ov_k)
            If (ov_k) overlap = .true.
         ElseIf (pot_int < 1) Then
            Call ener_LJ(i1, k, e_old_1, ov_k)
            If (ov_k) overlap = .true.
            Call ener_LJ(i2, k, e_old_2, ov_k)
            If (ov_k) overlap = .true.
         Else
            Call ener(i1, k, e_old_1, ov_k)
            If (ov_k) overlap = .true.
            Call ener(i2, k, e_old_2, ov_k)
            If (ov_k) overlap = .true.
         EndIf
         ! Re-apply swapped types for remainder of the loop
         itype(i1) = orig_type2
         itype(i2) = orig_type1

         If (pot_int /= -1) Then
            delta_e = delta_e + (e_new_1 - e_old_1) + (e_new_2 - e_old_2)
         EndIf
      EndIf
   EndDo

   ! Restore original types
   itype(i1) = orig_type1
   itype(i2) = orig_type2
End Subroutine calc_swap_energy_cpu
