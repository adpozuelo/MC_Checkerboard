! ==============================================================================
! PARTICLE TYPE INDEXING CONVENTION:
! The main codebase, namelists, and internal arrays use 0-based particle indexing
! (0 to Npart_types - 1). For compatibility with external LAMMPS calls and data formats
! (which expect 1-based atom types 1 to Npart_types), particle types are shifted by +1
! (e.g., itype(i) + 1) when writing LAMMPS data files or invoking LAMMPS routines.
! ==============================================================================

module lammps_hmc_wrapper
    use, intrinsic :: iso_c_binding
    use liblammps ! Native LAMMPS Fortran module
    use set_precision
    implicit none

    type(lammps) :: lmp
    logical :: hmc_initialized = .false.
    logical :: lmp_system_loaded = .false.
    real(wp) :: lmp_cached_box(0:2) = 0.0_wp
    integer :: lammps_gpu_id_global = 0
    real(c_double), allocatable, target :: pos_real(:)
    integer(c_int), allocatable, target :: atom_types_lmp(:)

contains

    subroutine init_hmc_lammps(lammps_gpu_id)
        use potential, only : table_lammps, table_file_lammps, table_file_mc
        use rundata, only : pot_int, model, lammps_gpu
        integer, intent(in) :: lammps_gpu_id
        character(len=32) :: args(14)
        if (.not. hmc_initialized) then
            if (table_lammps .or. trim(model) == 'TABLE' .or. trim(model) == 'table') then
                table_lammps = .true.
                call write_lammps_table_file()
            else if (pot_int == 2) then
                call write_lammps_analytic_file()
            end if
            
            lammps_gpu_id_global = lammps_gpu_id
            
            if (lammps_gpu) then
                args(1) = "liblammps"
                args(2) = "-screen"
                args(3) = "lammps_screen.log"
                args(4) = "-log"
                args(5) = "lammps_run.log"
                args(6) = "-pk"
                args(7) = "gpu"
                args(8) = "1"
                args(9) = "gpuID"
                write(args(10), '(I0)') lammps_gpu_id_global
                args(11) = "neigh"
                if (table_lammps .or. trim(model) == 'TABLE' .or. trim(model) == 'table') then
                    args(12) = "yes"
                else
                    args(12) = "no"
                end if
                args(13) = "-sf"
                args(14) = "gpu"
                lmp = lammps(args)
            else
                args(1) = "liblammps"
                args(2) = "-screen"
                args(3) = "lammps_screen.log"
                args(4) = "-log"
                args(5) = "lammps_run.log"
                lmp = lammps(args(1:5))
            end if
            hmc_initialized = .true.
        end if
    end subroutine init_hmc_lammps

    subroutine close_hmc_lammps()
        implicit none
        if (hmc_initialized) then
            call lmp%close(.true.)
            hmc_initialized = .false.
            lmp_system_loaded = .false.
            if (allocated(pos_real)) deallocate(pos_real)
            if (allocated(atom_types_lmp)) deallocate(atom_types_lmp)
        end if
    end subroutine close_hmc_lammps

    subroutine uppercase_str(str)
        implicit none
        character(len=*), intent(inout) :: str
        integer :: i, c
        do i = 1, len_trim(str)
            c = ichar(str(i:i))
            if (c >= 97 .and. c <= 122) str(i:i) = char(c - 32)
        end do
    end subroutine uppercase_str

    subroutine parse_table_n_line(line, n_pts, rmax, rmax_str)
        use set_precision
        implicit none
        character(len=*), intent(in) :: line
        integer, intent(out) :: n_pts
        real(wp), intent(out) :: rmax
        character(len=*), intent(out), optional :: rmax_str
        character(len=256) :: temp_str, rest_str, token1, token2
        integer :: pos, n_val, ierr
        real(wp) :: rmin_val, rmax_val
        
        n_pts = 1000
        rmax = 2.5_wp
        if (present(rmax_str)) rmax_str = "2.5"
        pos = index(line, 'N')
        if (pos == 0) pos = index(line, 'n')
        if (pos > 0) then
            temp_str = adjustl(line(pos+1:))
            read(temp_str, *, iostat=ierr) n_val
            if (ierr == 0) n_pts = n_val
            pos = verify(temp_str, ' 0123456789')
            if (pos > 0) then
                rest_str = adjustl(temp_str(pos:))
                pos = verify(rest_str, 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz ')
                if (pos > 0) then
                    read(rest_str(pos:), *, iostat=ierr) token1, token2
                    if (ierr == 0) then
                        read(token1, *, iostat=ierr) rmin_val
                        read(token2, *, iostat=ierr) rmax_val
                        if (ierr == 0) then
                            rmax = rmax_val
                            if (present(rmax_str)) rmax_str = trim(token2)
                        end if
                    end if
                end if
            end if
        end if
    end subroutine parse_table_n_line

    subroutine read_table_metadata(filename, keyword, n_pts, rmax, rmax_str)
        use set_precision
        implicit none
        character(len=*), intent(in) :: filename
        character(len=*), intent(inout) :: keyword
        integer, intent(out) :: n_pts
        real(wp), intent(out) :: rmax
        character(len=*), intent(out), optional :: rmax_str
        integer :: unit_id, ierr, pos
        character(len=256) :: line, last_kw, kw_target, kw_upper
        logical :: found, match
        
        n_pts = 1000
        rmax = 2.5_wp
        if (present(rmax_str)) rmax_str = "2.5"
        unit_id = 97
        open(unit=unit_id, file=trim(filename), status='old', action='read', iostat=ierr)
        if (ierr /= 0) return

        kw_target = trim(keyword)
        call uppercase_str(kw_target)
        
        found = .false.
        last_kw = ""
        do
            read(unit_id, '(A)', iostat=ierr) line
            if (ierr /= 0) exit
            line = adjustl(line)
            if (len_trim(line) == 0 .or. line(1:1) == '#') cycle
            
            if (line(1:2) /= 'N ' .and. line(1:2) /= 'n ' .and. line(1:2) /= 'N' .and. line(1:2) /= 'n') then
                last_kw = trim(line)
            else
                match = .false.
                if (len_trim(kw_target) == 0) then
                    match = .true.
                else
                    kw_upper = trim(last_kw)
                    call uppercase_str(kw_upper)
                    if (index(kw_upper, trim(kw_target)) > 0 .or. index(trim(kw_target), trim(kw_upper)) > 0) then
                        match = .true.
                    end if
                end if
                
                if (match) then
                    found = .true.
                    keyword = trim(last_kw)
                    call parse_table_n_line(line, n_pts, rmax, rmax_str)
                    exit
                end if
            end if
        end do
        
        ! If specific keyword wasn't matched, fallback to first section in file
        if (.not. found) then
            rewind(unit_id)
            last_kw = ""
            do
                read(unit_id, '(A)', iostat=ierr) line
                if (ierr /= 0) exit
                line = adjustl(line)
                if (len_trim(line) == 0 .or. line(1:1) == '#') cycle
                if (line(1:2) /= 'N ' .and. line(1:2) /= 'n ') then
                    last_kw = trim(line)
                else
                    found = .true.
                    keyword = trim(last_kw)
                    call parse_table_n_line(line, n_pts, rmax, rmax_str)
                    exit
                end if
            end do
        end if
        
        close(unit_id)
    end subroutine read_table_metadata

    ! ==============================================================================
    ! SUBROUTINE: write_lammps_table_file
    ! ==============================================================================
    ! DESCRIPTION:
    !   Generates the external LAMMPS potential scripts 'potential_table.lmp'
    !   and 'potential_ssp_table.lmp'.
    !   It parses the table files to calculate the maximum table size and 
    !   writes the pair_style and pair_coeff lines for loading tabulated 
    !   forces dynamically during MD runs.
    ! ==============================================================================
    subroutine write_lammps_table_file()
        use set_precision
        use potential, only : table_file_lammps, table_file_mc, Npart_types
        use rundata, only : pot_int, model
        implicit none
        integer :: unit_id, ierr, num_lmp_types, i_lmp, j_lmp, n_pts, max_N, cand_idx, num_candidates
        character(len=8) :: t1_str, t2_str
        character(len=256) :: keyword, filename, cand_file, candidates(16)
        character(len=256) :: actual_files(16, 16), actual_keywords(16, 16)
        character(len=64) :: actual_cutoffs_str(16, 16)
        real(wp) :: cutoffs(16, 16)
        logical :: file_exists, pair_found(16, 16)

        num_lmp_types = merge(2*Npart_types, Npart_types, pot_int == 2)
        pair_found = .false.
        max_N = 0

        ! Pass 1: find files and metadata for all pairs
        do i_lmp = 1, num_lmp_types
            do j_lmp = i_lmp, num_lmp_types
                write(t1_str, '(I0)') i_lmp
                write(t2_str, '(I0)') j_lmp
                
                num_candidates = 0
                if (len_trim(table_file_lammps) > 0) then
                    num_candidates = num_candidates + 1
                    candidates(num_candidates) = trim(table_file_lammps) // trim(t1_str) // trim(t2_str) // '.dat'
                    num_candidates = num_candidates + 1
                    candidates(num_candidates) = trim(table_file_lammps) // trim(t1_str) // trim(t2_str)
                    num_candidates = num_candidates + 1
                    candidates(num_candidates) = trim(table_file_lammps) // '_' // trim(t1_str) // '_' // trim(t2_str) // '.dat'
                    num_candidates = num_candidates + 1
                    candidates(num_candidates) = trim(table_file_lammps)
                end if
                if (len_trim(table_file_mc) > 0) then
                    num_candidates = num_candidates + 1
                    candidates(num_candidates) = trim(table_file_mc) // trim(t1_str) // trim(t2_str) // '.dat'
                    num_candidates = num_candidates + 1
                    candidates(num_candidates) = trim(table_file_mc) // trim(t1_str) // trim(t2_str)
                    num_candidates = num_candidates + 1
                    candidates(num_candidates) = trim(table_file_mc) // '_' // trim(t1_str) // '_' // trim(t2_str) // '.dat'
                    num_candidates = num_candidates + 1
                    candidates(num_candidates) = trim(table_file_mc)
                end if
                num_candidates = num_candidates + 1
                candidates(num_candidates) = 'pot' // trim(t1_str) // trim(t2_str) // '.dat'
                num_candidates = num_candidates + 1
                candidates(num_candidates) = 'table' // trim(t1_str) // trim(t2_str) // '.dat'
                num_candidates = num_candidates + 1
                candidates(num_candidates) = 'table_' // trim(t1_str) // '_' // trim(t2_str) // '.dat'
                num_candidates = num_candidates + 1
                candidates(num_candidates) = 'table.dat'
                num_candidates = num_candidates + 1
                candidates(num_candidates) = 'pot.dat'

                filename = ""
                do cand_idx = 1, num_candidates
                    cand_file = candidates(cand_idx)
                    inquire(file=trim(cand_file), exist=file_exists)
                    if (file_exists) then
                        filename = trim(cand_file)
                        exit
                    end if
                end do

                if (len_trim(filename) > 0) then
                    write(keyword, '(I0, A, I0)') i_lmp, '_', j_lmp
                    call read_table_metadata(filename, keyword, n_pts, cutoffs(i_lmp, j_lmp), actual_cutoffs_str(i_lmp, j_lmp))
                    if (pot_int == 2) then
                        cutoffs(i_lmp, j_lmp) = cutoffs(i_lmp, j_lmp) - 2.0e-6_wp
                    end if
                    actual_files(i_lmp, j_lmp) = trim(filename)
                    actual_keywords(i_lmp, j_lmp) = trim(keyword)
                    pair_found(i_lmp, j_lmp) = .true.
                    max_N = max(max_N, n_pts)
                end if
            end do
        end do

        if (max_N == 0) max_N = 100000

        ! Write to potential_table.lmp and potential_ssp_table.lmp
        do unit_id = 95, 96
            if (unit_id == 95) then
                open(unit=unit_id, file="potential_table.lmp", status="replace", action="write", iostat=ierr)
            else
                open(unit=unit_id, file="potential_ssp_table.lmp", status="replace", action="write", iostat=ierr)
            end if
            if (ierr /= 0) cycle

            write(unit_id, '(A, I0)') "pair_style table linear ", max_N

            do i_lmp = 1, num_lmp_types
                do j_lmp = i_lmp, num_lmp_types
                    if (pair_found(i_lmp, j_lmp)) then
                        if (pot_int == 2) then
                            write(unit_id, '(A, I0, A, I0, A, A, A, A, A, F18.12)') &
                                "pair_coeff ", i_lmp, " ", j_lmp, " ", trim(actual_files(i_lmp, j_lmp)), &
                                " ", trim(actual_keywords(i_lmp, j_lmp)), " ", cutoffs(i_lmp, j_lmp)
                        else
                            write(unit_id, '(A, I0, A, I0, A, A, A, A, A, A)') &
                                "pair_coeff ", i_lmp, " ", j_lmp, " ", trim(actual_files(i_lmp, j_lmp)), &
                                " ", trim(actual_keywords(i_lmp, j_lmp)), " ", trim(actual_cutoffs_str(i_lmp, j_lmp))
                        end if
                    end if
                end do
            end do
            close(unit_id)
        end do
    end subroutine write_lammps_table_file

    ! ==============================================================================
    ! SUBROUTINE: write_lammps_analytic_file
    ! ==============================================================================
    ! DESCRIPTION:
    !   Generates the external LAMMPS potential script 'potential_ssp_analytic.lmp'.
    !   It formats and writes the pair_style and pair_coeff lines for the
    !   colloid-colloid WCA interaction, the attractive cosine-squared tail,
    !   and the patch-patch anisotropic interaction.
    ! ==============================================================================
    subroutine write_lammps_analytic_file()
        use set_precision
        use potential, only : sigma_LJ, epsilon_LJ, Vpot_Matrix, Rc_factor, sigp_factor, Rcp_factor, epsp_factor, &
                              Npart_types, Nrb_sites, Nrb_sites_max
        use configuration, only : ndim
        implicit none
        integer :: unit_id, ierr, i, j, k, l, idx
        real(wp) :: sigma_ii

        unit_id = 96
        open(unit=unit_id, file="potential_ssp_analytic.lmp", status="replace", action="write", iostat=ierr)
        if (ierr /= 0) then
            print *, "Error: Could not open potential_ssp_analytic.lmp for writing"
            stop
        end if

        write(unit_id, '(A)') "pair_style hybrid/overlay lj/cut 20.0 cosine/squared 20.0"
        write(unit_id, '(A)') "pair_coeff * * lj/cut 0.0 1.0 0.0"
        write(unit_id, '(A)') "pair_coeff * * cosine/squared 0.0 1.0 2.0"

        do i = 0, Npart_types - 1
            do j = 0, Npart_types - 1
                sigma_ii = sigma_LJ(i*Npart_types+j)
                write(unit_id, '(A, I5, A, I5, A, F15.7, A, F15.7, A, F15.7)') &
                    "pair_coeff ", 2*i+1, " ", 2*j+1, " lj/cut ", epsilon_LJ(i*Npart_types+j), " ", &
                    sigma_ii, " ", sigma_ii * 1.122462048309373_wp
                
                if (epsp_factor > 0.0_wp) then
                    write(unit_id, '(A, I5, A, I5, A, F15.7, A, F15.7, A, F15.7)') &
                        "pair_coeff ", 2*i+1, " ", 2*j+1, " cosine/squared ", epsp_factor * epsilon_LJ(i*Npart_types+j), " ", &
                        sigma_ii * 1.122462048309373_wp, " ", Rc_factor * sigma_ii * 1.122462048309373_wp
                end if
                
                do k = 0, Nrb_sites(i) - 1
                    do l = 0, Nrb_sites(j) - 1
                        idx = i * Nrb_sites_max + k
                        idx = idx * Nrb_sites_max * Npart_types
                        idx = idx + j * Nrb_sites_max + l
                        if (Vpot_Matrix(idx) > 1.0e-7_wp) then
                            write(unit_id, '(A, I5, A, I5, A, F15.7, A, F15.7, A, F15.7)') &
                                "pair_coeff ", 2*i+2, " ", 2*j+2, " cosine/squared ", Vpot_Matrix(idx), " ", &
                                sigp_factor * sigma_ii * 1.122462048309373_wp, " ", &
                                Rcp_factor * sigma_ii * 1.122462048309373_wp
                        end if
                    end do
                end do
            end do
        end do
        close(unit_id)
    end subroutine write_lammps_analytic_file


    ! ==============================================================================
    ! SUBROUTINE: setup_lammps_system
    ! ==============================================================================
    ! DESCRIPTION:
    !   Initializes the persistent in-memory LAMMPS simulation state.
    !   Writes lammps_hmc.data once to establish topology (atom IDs, molecule IDs,
    !   masses, box bounds), parses potential scripts, sets up integration fixes
    !   (fix rigid/nve or fix nve), and defines computes.
    !   Subsequent HMC trial steps reuse this persistent memory state via
    !   in-memory scatter_atoms/gather_atoms without resetting or re-parsing files.
    ! ==============================================================================
    subroutine setup_lammps_system()
        use set_precision
        use configuration
        use potential
        use rundata, only: pot_int, model, temp, seed, Nmc_hmc, Nmd_hmc, tstep_hmc, &
                           lammps_skin, lammps_thermo, lammps_gpu
        implicit none
        integer :: i, j, it, idx, n_patches, n_types, total_atoms
        real(wp) :: R_rot(3,3), PX, PY, PZ, p_x, p_y, p_z, sigma_ii
        character(len=512) :: cmd

        if (.not. hmc_initialized) call init_hmc_lammps(lammps_gpu_id_global)

        ! Cache box dimensions
        lmp_cached_box(0) = Box(0)
        lmp_cached_box(1) = Box(1)
        lmp_cached_box(2) = Box(2)

        ! 1. Count total atoms and types
        if (pot_int == 2) then ! SSP
            n_types = 2 * Npart_types
            total_atoms = natoms
            do i = 1, natoms
                total_atoms = total_atoms + Nrb_sites(itype(i-1))
            end do
        else ! TABLE
            n_types = Npart_types
            total_atoms = natoms
        end if

        ! 2. Allocate persistent in-memory buffers
        if (allocated(pos_real)) deallocate(pos_real)
        allocate(pos_real(3 * total_atoms))

        if (allocated(atom_types_lmp)) deallocate(atom_types_lmp)
        allocate(atom_types_lmp(total_atoms))

        ! 3. Populate initial coordinates and atom types
        idx = 0
        if (pot_int == 2) then
            do i = 1, natoms
                it = itype(i-1)
                idx = idx + 1
                pos_real(3*(idx-1) + 1) = R(3*(i-1))*Box(0)
                pos_real(3*(idx-1) + 2) = R(3*(i-1)+1)*Box(1)
                pos_real(3*(idx-1) + 3) = R(3*(i-1)+2)*Box(2)
                atom_types_lmp(idx) = int(2*it + 1, c_int)

                n_patches = Nrb_sites(it)
                if (n_patches > 0) then
                    call rot_matrix(q(4*(i-1)), q(4*(i-1)+1), q(4*(i-1)+2), q(4*(i-1)+3), R_rot)
                    sigma_ii = sigma_LJ(it * Npart_types + it)
                    do j = 0, n_patches - 1
                        PX = patch(Nrb_sites_max*ndim*it + j*ndim)
                        PY = patch(Nrb_sites_max*ndim*it + j*ndim + 1)
                        PZ = patch(Nrb_sites_max*ndim*it + j*ndim + 2)
                        p_x = patch_radial_factor * sigma_ii * (R_rot(1,1)*PX + R_rot(1,2)*PY + R_rot(1,3)*PZ)
                        p_y = patch_radial_factor * sigma_ii * (R_rot(2,1)*PX + R_rot(2,2)*PY + R_rot(2,3)*PZ)
                        p_z = patch_radial_factor * sigma_ii * (R_rot(3,1)*PX + R_rot(3,2)*PY + R_rot(3,3)*PZ)

                        idx = idx + 1
                        pos_real(3*(idx-1) + 1) = R(3*(i-1))*Box(0) + p_x
                        pos_real(3*(idx-1) + 2) = R(3*(i-1)+1)*Box(1) + p_y
                        pos_real(3*(idx-1) + 3) = R(3*(i-1)+2)*Box(2) + p_z
                        atom_types_lmp(idx) = int(2*it + 2, c_int)
                    end do
                end if
            end do
        else
            do i = 1, natoms
                pos_real(3*(i-1) + 1) = R(3*(i-1))*Box(0)
                pos_real(3*(i-1) + 2) = R(3*(i-1)+1)*Box(1)
                pos_real(3*(i-1) + 3) = R(3*(i-1)+2)*Box(2)
                atom_types_lmp(i) = int(itype(i-1) + 1, c_int)
            end do
        end if

        ! 4. Write initial lammps_hmc.data file to establish topology
        open(unit=99, file='lammps_hmc.data', status='replace')
        write(99, '("LAMMPS data file for Hybrid MC")')
        write(99, '(I10, " atoms")') total_atoms
        write(99, '(I10, " atom types")') n_types
        write(99, *)
        write(99, '(F18.8, F18.8, " xlo xhi")') 0.0_wp, Box(0)
        write(99, '(F18.8, F18.8, " ylo yhi")') 0.0_wp, Box(1)
        write(99, '(F18.8, F18.8, " zlo zhi")') 0.0_wp, Box(2)
        write(99, *)
        write(99, '("Masses")')
        write(99, *)
        if (pot_int == 2) then
            do i = 0, Npart_types - 1
                write(99, '(I5, F10.4)') 2*i + 1, 1.0_wp
                write(99, '(I5, F10.4)') 2*i + 2, 0.02_wp
            end do
        else
            do i = 0, Npart_types - 1
                write(99, '(I5, F10.4)') i + 1, 1.0_wp
            end do
        end if
        write(99, *)
        write(99, '("Atoms")')
        write(99, *)

        idx = 0
        if (pot_int == 2) then
            do i = 1, natoms
                it = itype(i-1)
                idx = idx + 1
                write(99, '(I10, I10, I5, F6.2, 3F18.8)') &
                    idx, i, 2*it + 1, 0.0_wp, pos_real(3*(idx-1)+1), pos_real(3*(idx-1)+2), pos_real(3*(idx-1)+3)
                n_patches = Nrb_sites(it)
                do j = 0, n_patches - 1
                    idx = idx + 1
                    write(99, '(I10, I10, I5, F6.2, 3F18.8)') &
                        idx, i, 2*it + 2, 0.0_wp, pos_real(3*(idx-1)+1), pos_real(3*(idx-1)+2), pos_real(3*(idx-1)+3)
                end do
            end do
        else
            do i = 1, natoms
                write(99, '(I10, I10, I5, F6.2, 3F18.8)') &
                    i, i, itype(i-1) + 1, 0.0_wp, pos_real(3*(i-1)+1), pos_real(3*(i-1)+2), pos_real(3*(i-1)+3)
            end do
        end if
        close(99)

        ! 5. Send initialization commands to LAMMPS
        if (lmp_system_loaded) call lmp%command("clear")
        call lmp%command("units lj")
        call lmp%command("atom_style full")
        call lmp%command("boundary p p p")
        call lmp%command("read_data lammps_hmc.data")
        write(cmd, '(A, F15.7)') "timestep ", tstep_hmc
        call lmp%command(cmd)

        if (lammps_skin > 0.0_wp) then
            write(cmd, '(A, F12.6, A)') "neighbor ", lammps_skin, " bin"
            call lmp%command(cmd)
        end if

        ! Force field coefficients
        if (table_lammps .or. trim(model) == 'TABLE' .or. trim(model) == 'table') then
            if (pot_int == 2) then
                call lmp%command("include potential_ssp_table.lmp")
                call lmp%command("pair_modify shift yes")
                call lmp%command("fix hmc_rigid all rigid/nve molecule")
            else
                call lmp%command("include potential_table.lmp")
                call lmp%command("pair_modify shift yes")
                call lmp%command("fix hmc_nve all nve")
            end if
        else if (pot_int == 2) then ! SSP analytic
            call lmp%command("include potential_ssp_analytic.lmp")
            call lmp%command("pair_modify shift yes")
            call lmp%command("fix hmc_rigid all rigid/nve molecule")
        end if

        if (lammps_thermo > 0) then
            write(cmd, '(A, I8)') "thermo ", lammps_thermo
            call lmp%command(cmd)
        else
            call lmp%command("thermo 0")
        end if

        ! Define computes for kinetic and potential energy extraction
        call lmp%command("compute hmc_ke all ke")
        call lmp%command("compute hmc_pe all pe")

        ! Initial warm-up run 0 to construct neighbor lists and GPU buffers
        call lmp%command("velocity all create 0.1 12345 loop geom")
        call lmp%command("run 0")

        lmp_system_loaded = .true.
    end subroutine setup_lammps_system


    subroutine execute_hmc_step(istep)
        use set_precision
        use configuration
        use potential
        use rundata, only: pot_int, model, temp, seed, Nmc_hmc, Nmd_hmc, tstep_hmc, &
                           lammps_skin, lammps_thermo, lammps_gpu, swap_moves
        use Cell
        use utils, only: c_green, c_red, c_reset
        use cudafor, only : cudaEvent, cudaEventCreate, cudaEventRecord, cudaEventSynchronize, cudaEventElapsedTime, cudaEventDestroy
        implicit none
        integer, intent(in) :: istep
        
        integer :: i, j, k, l, it, idx, total_atoms, n_patches, n_types
        character(len=512) :: cmd
        real(wp) :: R_rot(3,3), PX, PY, PZ, p_x, p_y, p_z, sigma_ii
        real(c_double) :: E_initial, E_final, E_initial_pe, E_final_pe, E_final_ke
        real(wp) :: rnd_val
        real(wp) :: u_x_0(3), u_y_0(3), u_z_0(3)
        real(wp) :: u_x_p(3), u_y_p(3), u_z_p(3)
        real(wp) :: px0, py0, pz0, px1, py1, pz1
        real(wp) :: q_new(4), norm_q
        integer :: seed_hmc
        real(wp) :: hmc_cpu_start, hmc_cpu_end, hmc_cpu_time
        type(cudaEvent) :: hmc_start_event, hmc_stop_event
        real(4) :: hmc_gpu_time_ms
        integer :: hmc_istat
        logical :: accepted
        
        ! Synchronize flat regular coordinate arrays from GPU checkerboard cells
        call Convert_CB_RU()
        
        hmc_istat = cudaEventCreate(hmc_start_event)
        hmc_istat = cudaEventCreate(hmc_stop_event)
        call cpu_time(hmc_cpu_start)
        hmc_istat = cudaEventRecord(hmc_start_event, 0)
        
        ! 1. Check if model is SSP or TABLE
        if (trim(model) /= 'SSP' .and. trim(model) /= 'TABLE' .and. trim(model) /= 'table') then
            write(*,*) " [HMC Error] HMC strategy is only available for SSP and TABLE models."
            stop
        end if

        ! 2. Initialize persistent LAMMPS state if not loaded or if box dimensions changed
        if (.not. lmp_system_loaded .or. any(abs(lmp_cached_box - Box) > 1.0e-8_wp)) then
            call setup_lammps_system()
        end if

        ! 3. Count total atoms for energy normalization
        if (pot_int == 2) then ! SSP
            total_atoms = natoms
            do i = 1, natoms
                total_atoms = total_atoms + Nrb_sites(itype(i-1))
            end do
        else ! TABLE
            total_atoms = natoms
        end if

        ! 4. Populate in-memory position array from current MC configuration
        idx = 0
        if (pot_int == 2) then
            do i = 1, natoms
                it = itype(i-1)
                idx = idx + 1
                pos_real(3*(idx-1) + 1) = R(3*(i-1))*Box(0)
                pos_real(3*(idx-1) + 2) = R(3*(i-1)+1)*Box(1)
                pos_real(3*(idx-1) + 3) = R(3*(i-1)+2)*Box(2)
                if (swap_moves .and. Npart_types >= 2) then
                    atom_types_lmp(idx) = int(2*it + 1, c_int)
                end if

                n_patches = Nrb_sites(it)
                if (n_patches > 0) then
                    call rot_matrix(q(4*(i-1)), q(4*(i-1)+1), q(4*(i-1)+2), q(4*(i-1)+3), R_rot)
                    sigma_ii = sigma_LJ(it * Npart_types + it)
                    do j = 0, n_patches - 1
                        PX = patch(Nrb_sites_max*ndim*it + j*ndim)
                        PY = patch(Nrb_sites_max*ndim*it + j*ndim + 1)
                        PZ = patch(Nrb_sites_max*ndim*it + j*ndim + 2)
                        p_x = patch_radial_factor * sigma_ii * (R_rot(1,1)*PX + R_rot(1,2)*PY + R_rot(1,3)*PZ)
                        p_y = patch_radial_factor * sigma_ii * (R_rot(2,1)*PX + R_rot(2,2)*PY + R_rot(2,3)*PZ)
                        p_z = patch_radial_factor * sigma_ii * (R_rot(3,1)*PX + R_rot(3,2)*PY + R_rot(3,3)*PZ)

                        idx = idx + 1
                        pos_real(3*(idx-1) + 1) = R(3*(i-1))*Box(0) + p_x
                        pos_real(3*(idx-1) + 2) = R(3*(i-1)+1)*Box(1) + p_y
                        pos_real(3*(idx-1) + 3) = R(3*(i-1)+2)*Box(2) + p_z
                        if (swap_moves .and. Npart_types >= 2) then
                            atom_types_lmp(idx) = int(2*it + 2, c_int)
                        end if
                    end do
                end if
            end do
        else
            do i = 1, natoms
                pos_real(3*(i-1) + 1) = R(3*(i-1))*Box(0)
                pos_real(3*(i-1) + 2) = R(3*(i-1)+1)*Box(1)
                pos_real(3*(i-1) + 3) = R(3*(i-1)+2)*Box(2)
                if (swap_moves .and. Npart_types >= 2) then
                    atom_types_lmp(i) = int(itype(i-1) + 1, c_int)
                end if
            end do
        end if

        ! 5. In-memory data injection to LAMMPS (bypassing disk I/O & reset)
        call lmp%scatter_atoms("x", pos_real)
        if (swap_moves .and. Npart_types >= 2) then
            call lmp%scatter_atoms("type", atom_types_lmp)
        end if

        if (pot_int == 2) then
            call lmp%command("unfix hmc_rigid")
            call lmp%command("set group all image 0 0 0")
            call lmp%command("fix hmc_rigid all rigid/nve molecule")
        end if
        call lmp%command("reset_timestep 0")

        ! 6. Thermal velocities and initial energy evaluation
        seed_hmc = seed + istep
        write(cmd, '(A, F15.7, A, I8, A)') "velocity all create ", temp, " ", seed_hmc, " loop geom"
        call lmp%command(cmd)

        call lmp%command("run 0")
        E_initial_pe = lmp%extract_compute("hmc_pe", 0, 0)%r64
        E_initial = E_initial_pe + lmp%extract_compute("hmc_ke", 0, 0)%r64

        ! 7. Run MD trajectory
        write(cmd, '(A, I8)') "run ", Nmd_hmc
        call lmp%command(cmd)

        ! 8. Final energy evaluation
        E_final_pe = lmp%extract_compute("hmc_pe", 0, 0)%r64
        E_final_ke = lmp%extract_compute("hmc_ke", 0, 0)%r64
        E_final = E_final_pe + E_final_ke

        ! 9. Metropolis criterion & state extraction
        accepted = .false.
        call random_number(rnd_val)
        if (.not. (E_final /= E_final .or. E_initial /= E_initial)) then
            if (exp(-(E_final - E_initial)/temp) > rnd_val) then
                accepted = .true.
                call lmp%gather_atoms("x", 3, pos_real)

                if (pot_int == 2) then ! SSP
                    idx = 0
                    do i = 1, natoms
                        it = itype(i-1)
                        idx = idx + 1
                        R(3*(i-1)) = pos_real(3*(idx-1) + 1) / Box(0)
                        R(3*(i-1)+1) = pos_real(3*(idx-1) + 2) / Box(1)
                        R(3*(i-1)+2) = pos_real(3*(idx-1) + 3) / Box(2)
                        R(3*(i-1))   = R(3*(i-1))   - floor(R(3*(i-1)))
                        R(3*(i-1)+1) = R(3*(i-1)+1) - floor(R(3*(i-1)+1))
                        R(3*(i-1)+2) = R(3*(i-1)+2) - floor(R(3*(i-1)+2))

                        n_patches = Nrb_sites(it)
                        if (n_patches > 0) then
                            px0 = patch(Nrb_sites_max*ndim*it)
                            py0 = patch(Nrb_sites_max*ndim*it + 1)
                            pz0 = patch(Nrb_sites_max*ndim*it + 2)

                            px1 = patch(Nrb_sites_max*ndim*it + ndim)
                            py1 = patch(Nrb_sites_max*ndim*it + ndim + 1)
                            pz1 = patch(Nrb_sites_max*ndim*it + ndim + 2)

                            u_x_0 = (/ px0, py0, pz0 /)
                            u_x_0 = u_x_0 / sqrt(dot_product(u_x_0, u_x_0))

                            u_y_0 = (/ px1, py1, pz1 /)
                            u_y_0 = u_y_0 - dot_product(u_y_0, u_x_0) * u_x_0
                            u_y_0 = u_y_0 / sqrt(dot_product(u_y_0, u_y_0))

                            u_z_0 = (/ u_x_0(2)*u_y_0(3) - u_x_0(3)*u_y_0(2), &
                                       u_x_0(3)*u_y_0(1) - u_x_0(1)*u_y_0(3), &
                                       u_x_0(1)*u_y_0(2) - u_x_0(2)*u_y_0(1) /)

                            u_x_p = (/ pos_real(3*idx + 1) - pos_real(3*(idx-1) + 1), &
                                       pos_real(3*idx + 2) - pos_real(3*(idx-1) + 2), &
                                       pos_real(3*idx + 3) - pos_real(3*(idx-1) + 3) /)
                            u_x_p(1) = u_x_p(1) - Box(0) * anint(u_x_p(1) / Box(0))
                            u_x_p(2) = u_x_p(2) - Box(1) * anint(u_x_p(2) / Box(1))
                            u_x_p(3) = u_x_p(3) - Box(2) * anint(u_x_p(3) / Box(2))
                            u_x_p = u_x_p / sqrt(dot_product(u_x_p, u_x_p))

                            u_y_p = (/ pos_real(3*(idx+1) + 1) - pos_real(3*(idx-1) + 1), &
                                       pos_real(3*(idx+1) + 2) - pos_real(3*(idx-1) + 2), &
                                       pos_real(3*(idx+1) + 3) - pos_real(3*(idx-1) + 3) /)
                            u_y_p(1) = u_y_p(1) - Box(0) * anint(u_y_p(1) / Box(0))
                            u_y_p(2) = u_y_p(2) - Box(1) * anint(u_y_p(2) / Box(1))
                            u_y_p(3) = u_y_p(3) - Box(2) * anint(u_y_p(3) / Box(2))
                            u_y_p = u_y_p - dot_product(u_y_p, u_x_p) * u_x_p
                            u_y_p = u_y_p / sqrt(dot_product(u_y_p, u_y_p))

                            u_z_p = (/ u_x_p(2)*u_y_p(3) - u_x_p(3)*u_y_p(2), &
                                       u_x_p(3)*u_y_p(1) - u_x_p(1)*u_y_p(3), &
                                       u_x_p(1)*u_y_p(2) - u_x_p(2)*u_y_p(1) /)

                            do k = 1, 3
                                do l = 1, 3
                                    R_rot(k, l) = u_x_p(k)*u_x_0(l) + u_y_p(k)*u_y_0(l) + u_z_p(k)*u_z_0(l)
                                end do
                            end do

                            call matrix_to_quaternion(R_rot, q_new)
                            q(4*(i-1))   = q_new(1)
                            q(4*(i-1)+1) = q_new(2)
                            q(4*(i-1)+2) = q_new(3)
                            q(4*(i-1)+3) = q_new(4)

                            idx = idx + n_patches
                        end if
                    end do
                else ! TABLE
                    do i = 1, natoms
                        R(3*(i-1))   = pos_real(3*(i-1) + 1) / Box(0)
                        R(3*(i-1)+1) = pos_real(3*(i-1) + 2) / Box(1)
                        R(3*(i-1)+2) = pos_real(3*(i-1) + 3) / Box(2)
                        R(3*(i-1))   = R(3*(i-1))   - floor(R(3*(i-1)))
                        R(3*(i-1)+1) = R(3*(i-1)+1) - floor(R(3*(i-1)+1))
                        R(3*(i-1)+2) = R(3*(i-1)+2) - floor(R(3*(i-1)+2))
                    end do
                end if
                call repopulate_checkerboard_cells()
                call CB_system_energy_GPU(1)
            end if
        end if

        hmc_istat = cudaEventRecord(hmc_stop_event, 0)
        hmc_istat = cudaEventSynchronize(hmc_stop_event)
        hmc_istat = cudaEventElapsedTime(hmc_gpu_time_ms, hmc_start_event, hmc_stop_event)
        call cpu_time(hmc_cpu_end)
        hmc_cpu_time = hmc_cpu_end - hmc_cpu_start

        hmc_istat = cudaEventDestroy(hmc_start_event)
        hmc_istat = cudaEventDestroy(hmc_stop_event)

        if (accepted) then
            write(*,'(A, I8, A, F14.8, A, F14.8, A, F14.8, A, I0, A, F8.3, A, F8.3, A)') &
                c_green // '  >>> [HMC Step ', istep, '] ACCEPTED | E_pe/site: ', E_initial_pe/real(total_atoms,wp), &
                ' -> ', E_final_pe/real(total_atoms,wp), ' | E_ke/site: ', E_final_ke/real(total_atoms,wp), &
                ' | MD steps: ', Nmd_hmc, ' | CPU time: ', hmc_cpu_time, ' s | GPU time: ', real(hmc_gpu_time_ms, wp)/1000.0_wp, ' s' // c_reset
        else
            write(*,'(A, I8, A, F14.8, A, F14.8, A, F14.8, A, I0, A, F8.3, A, F8.3, A)') &
                c_red // '  >>> [HMC Step ', istep, '] REJECTED | E_pe/site: ', E_initial_pe/real(total_atoms,wp), &
                ' -> ', E_final_pe/real(total_atoms,wp), ' | E_ke/site: ', E_final_ke/real(total_atoms,wp), &
                ' | MD steps: ', Nmd_hmc, ' | CPU time: ', hmc_cpu_time, ' s | GPU time: ', real(hmc_gpu_time_ms, wp)/1000.0_wp, ' s' // c_reset
        end if
    end subroutine execute_hmc_step

    subroutine rot_matrix(q0, q1, q2, q3, R)
        real(wp), intent(in) :: q0, q1, q2, q3
        real(wp), intent(out) :: R(3, 3)
        R(1, 1) = q0*q0 + q1*q1 - q2*q2 - q3*q3
        R(1, 2) = 2.0_wp * (q1*q2 - q0*q3)
        R(1, 3) = 2.0_wp * (q1*q3 + q0*q2)
        R(2, 1) = 2.0_wp * (q1*q2 + q0*q3)
        R(2, 2) = q0*q0 - q1*q1 + q2*q2 - q3*q3
        R(2, 3) = 2.0_wp * (q2*q3 - q0*q1)
        R(3, 1) = 2.0_wp * (q1*q3 - q0*q2)
        R(3, 2) = 2.0_wp * (q2*q3 + q0*q1)
        R(3, 3) = q0*q0 - q1*q1 - q2*q2 + q3*q3
    end subroutine rot_matrix

    subroutine matrix_to_quaternion(R, q)
        real(wp), intent(in) :: R(3, 3)
        real(wp), intent(out) :: q(4)
        real(wp) :: tr, s
        tr = R(1,1) + R(2,2) + R(3,3)
        if (tr > 0.0_wp) then
            s = sqrt(tr + 1.0_wp) * 2.0_wp
            q(1) = 0.25_wp * s
            q(2) = (R(3,2) - R(2,3)) / s
            q(3) = (R(1,3) - R(3,1)) / s
            q(4) = (R(2,1) - R(1,2)) / s
        else if ((R(1,1) > R(2,2)) .and. (R(1,1) > R(3,3))) then
            s = sqrt(1.0_wp + R(1,1) - R(2,2) - R(3,3)) * 2.0_wp
            q(1) = (R(3,2) - R(2,3)) / s
            q(2) = 0.25_wp * s
            q(3) = (R(1,2) + R(2,1)) / s
            q(4) = (R(1,3) + R(3,1)) / s
        else if (R(2,2) > R(3,3)) then
            s = sqrt(1.0_wp + R(2,2) - R(1,1) - R(3,3)) * 2.0_wp
            q(1) = (R(1,3) - R(3,1)) / s
            q(2) = (R(1,2) + R(2,1)) / s
            q(3) = 0.25_wp * s
            q(4) = (R(2,3) + R(3,2)) / s
        else
            s = sqrt(1.0_wp + R(3,3) - R(1,1) - R(2,2)) * 2.0_wp
            q(1) = (R(2,1) - R(1,2)) / s
            q(2) = (R(1,3) + R(3,1)) / s
            q(3) = (R(2,3) + R(3,2)) / s
            q(4) = 0.25_wp * s
        end if
        s = sqrt(q(1)**2 + q(2)**2 + q(3)**2 + q(4)**2)
        q = q / s
    end subroutine matrix_to_quaternion

end module lammps_hmc_wrapper