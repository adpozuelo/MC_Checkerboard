# 3d Lennard-Jones melt

units           lj
atom_style      atomic


variable dens equal 0.625
variable N equal 125000
variable nrep equal round((${N})^0.333333)
# lattice scale is reduced density in LJ units
lattice sc ${dens}
region  box block 0 1 0 1  0 1  units lattice
create_box      2 box
create_atoms 1 box
replicate ${nrep} ${nrep} ${nrep} 
variable N equal count(all)
timestep 0.001
# Loop to assign 1/3 of the atoms to type B
label loop
variable a loop ${N}
variable rest equal ${a}%3

if "${rest} == 0" then "set atom ${a} type 2"
next a
jump SELF loop



mass            1 1.0
mass            2 1.0

velocity        all create 3.0 87287 loop geom

include forcefield.LJ

#neighbor        0.3 bin
#neigh_modify    every 20 delay 0 check no

fix             1 all nve

#dump           id all atom 50 dump.melt

#dump           2 all image 25 image.*.jpg type type &
#               axes yes 0.8 0.02 view 60 -30
#dump_modify    2 pad 3

#dump           3 all movie 25 movie.mpg type type &
#               axes yes 0.8 0.02 view 60 -30
#dump_modify    3 pad 3

thermo          10
run             2000
write_data      final.dat nocoeff
