! ==============================================================================
! MONTE CARLO SIMULATION CONTROL PARAMETERS
! ==============================================================================
&Control_Params
  istep_ini      = 0,          ! Initial step number (0 for new simulation, >0 for restart)
  istep_fin      = 3,          ! Total number of MC sweeps (steps) to execute
  Neq            = 0,          ! Number of equilibration sweeps before accumulating averages
  Nmove          = 1,          ! Trial displacement moves per particle attempted in each MC sweep
  Nsave          = 10,         ! Frequency (in sweeps) for writing progress stdout & block averages
  Ndump          = 10,         ! Frequency (in sweeps) for writing trajectory frames
  Nrestart       = 500,        ! Frequency (in sweeps) for saving restart checkpoints
  imovie         = .false.,    ! Enable trajectory output (.true. / .false.)
  data_file      = 'data.beg', ! Initial atomic configuration file (LAMMPS data format)
  traj_format    = 'netcdf',   ! Trajectory output format: 'plain' (text), 'netcdf' (binary), or 'both'
  Npart_types    = 2,          ! Number of particle species in system (2 for binary mixture)
  Ecpu_check     = .false.,    ! Enable initial and final CPU energy verification
  ncluster       = 0,          ! Frequency (in sweeps) for DBSCAN cluster analysis (0 = disabled)
  rcl            = 2.5,        ! Radial neighbor connectivity threshold for DBSCAN clustering
  minPts         = 7,          ! Minimum neighbor particles to classify a core cluster particle
  cluster_types  = 1, 3,       ! Particle species selected for cluster detection analysis
  Nmc_hmc        = 1,          ! Frequency (in MC sweeps) of hybrid LAMMPS HMC trial moves
  Nmd_hmc        = 50,         ! Number of MD steps per HMC trajectory segment
  tstep_hmc      = 0.0025      ! MD integration timestep duration in reduced units
/

! ==============================================================================
! MONTE CARLO SAMPLING & THERMODYNAMIC PARAMETERS
! ==============================================================================
&MC_Params
  hmax         = 0.5,          ! Maximum particle translation step size (in units of sigma)
  omax         = 0.5,          ! Maximum particle rotation step size (in radians)
  vmax         = 0.1, 0.1, 0.1,! Maximum box edge length displacement (Lx, Ly, Lz) for NpT moves
  displ_update = .false.,      ! Enable automatic adjustment of hmax/omax (~40% acceptance)
  temp0        = 0.15,         ! Initial reduced temperature T0* = kB*T/epsilon
  temp1        = 0.15,         ! Final reduced temperature T1*
  npt          = .false.,      ! Isobaric-isothermal ensemble (.true. for NpT, .false. for NVT)
  iscale       = 0,            ! Isotropic box scaling flag (0 = independent Lx,Ly,Lz, 1 = isotropic)
  pres         = 0.1,          ! Reduced pressure P* (for NpT ensemble)
  seed         = 345           ! Random number generator seed
/

! ==============================================================================
! POTENTIAL MODEL SELECTION & SSP PALAIA MODEL PARAMETERS
! ==============================================================================
&Potential_Params
  model             = 'SSP',     ! Potential model: 'SSP' (Site-Site Patchy Palaia model)
  sigma_jon_aux     = -0.3,      ! Auxiliary angular patch width (< 0 reads individual sigmas_ang)
  sigma_tor_jon     = 0.0,       ! Torsional patch interaction width parameter
  rangepp           = 2.5,       ! Radial potential cutoff distance factor (Rcut = rangepp * sigma)
  Bool_tor          = 0,         ! Enable torsional patch alignment (1 = active, 0 = disabled)
  sigp_factor       = 0.1,       ! Patch radius scaling factor r_patch = sigp_factor * sigma
  Rcp_factor        = 0.3,       ! Patch interaction cutoff scaling factor Rcp = Rcp_factor * sigma
  Rc_factor         = 2.0,       ! Colloid core attractive tail cutoff scaling factor R_tail = Rc_factor * Rc
  epsp_factor       = 0.2,       ! Colloid core attractive tail well depth eps_tail
  table_mc          = .true.,    ! Enable MC tabulated potential evaluations on GPU (.true. = tabulated)
  table_lammps      = .true.,    ! Enable LAMMPS tabulated force calculations (.true. = tabulated)
  table_file_mc     = 'salr_mc', ! Base prefix for MC potential table files
  table_file_lammps = 'salr_lmp' ! Base prefix for LAMMPS potential table files
/

