! ==============================================================================
! MONTE CARLO SIMULATION CONTROL PARAMETERS
! ==============================================================================
&Control_Params
  istep_ini        = 63350,          ! Initial step number (restart checkpoint step)
  istep_fin        = 500000,         ! Total production MC sweeps to execute
  Neq              = 0,              ! Number of equilibration sweeps (0 for continuing run)
  Nmove            = 20,             ! Trial displacement moves per particle attempted in each MC sweep (10 trans + 10 rot)
  Nsave            = 2,              ! Frequency (in sweeps) for writing progress stdout & block averages
  Ndump            = 10,             ! Frequency (in sweeps) for writing trajectory frames
  Nrestart         = 50,             ! Frequency (in sweeps) for saving restart checkpoints
  imovie           = .true.,         ! Enable trajectory output (.true. / .false.)
  traj_format      = 'netcdf',       ! Trajectory output format: 'plain' (text), 'netcdf' (binary), or 'both'
  data_file        = 'data.restart', ! Initial atomic configuration file (LAMMPS data format restart)
  Npart_types      = 2,              ! Number of particle species in system (2 for binary mixture)
  Ecpu_check       = .true.,         ! Enable initial and final CPU energy validation check
  ncluster         = 50,             ! Frequency (in sweeps) for DBSCAN cluster analysis
  rcl              = 1.2,            ! Radial neighbor connectivity threshold for DBSCAN clustering
  minPts           = 3,              ! Minimum neighbor particles to classify a core cluster particle
  asym_threshold   = 0.5,            ! Geometric asymmetry threshold for identifying border cluster particles
  cluster_types    = 1, 2,           ! Particle species selected for cluster detection analysis
  avbmc            = .true.,         ! Enable Aggregation Volume Bias Monte Carlo (AVBMC) moves (.true. / .false.)
  border_criterion = 'asymmetry',    ! Border particle detection criterion ('asymmetry' or 'energy')
  avbmc_k_trials   = 10,             ! Number of Rosenbluth trial insertions in bulk phase per AVBMC attempt
  avbmc_max_trials = 50,             ! Maximum AVBMC pair trial attempts per step
  lammps           = .false.         ! Master switch: Enable hybrid LAMMPS HMC moves (.true. / .false.)
/

! ==============================================================================
! MONTE CARLO SAMPLING & THERMODYNAMIC PARAMETERS
! ==============================================================================
&MC_Params
  hmax         = 2.6500451E-03,      ! Maximum particle translation step size (in units of sigma)
  omax         = 7.3744237E-02,      ! Maximum particle rotation step size (in radians)
  vmax         = 0.0, 0.0, 0.0,      ! Maximum box edge length displacement (Lx, Ly, Lz) for NpT moves
  displ_update = .true.,             ! Enable automatic adjustment of hmax/omax (~40% acceptance)
  temp0        = 1.0,                ! Initial reduced temperature T0* = kB*T/epsilon
  npt          = .false.,            ! Isobaric-isothermal ensemble (.true. for NpT, .false. for NVT canonical)
  Nvolf        = 1,                  ! Frequency (in sweeps) of NpT volume change attempts
  iscale       = 0,                  ! Isotropic box scaling flag (0 = independent Lx,Ly,Lz, 1 = isotropic)
  pres         = 0.0,                ! Reduced pressure P* (unused for NVT)
  seed         = 492845,             ! Random number generator seed
  swap_moves   = .false.,            ! Enable GPU checkerboard identity swap moves (.true. / .false.)
  Nswap        = 1,                  ! Number of swap sub-passes executed per swap step
  Nswapf       = 1                   ! Frequency (in sweeps) of identity swap attempts
/

! ==============================================================================
! POTENTIAL MODEL SELECTION & SANCHEZ-BURGOS MODEL PARAMETERS
! ==============================================================================
&Potential_Params
  model               = 'SB',        ! Potential model: 'SB' (Sanchez-Burgos continuous patchy model)
  sigma_jon_aux       = -0.3,        ! Auxiliary angular patch width (< 0 reads individual sigmas_ang)
  sigma_tor_jon       = 0.0,         ! Torsional patch interaction width parameter
  rangepp             = 2.0,         ! Radial potential cutoff distance factor (Rcut = rangepp * sigma)
  Bool_tor            = 0,           ! Enable torsional patch alignment (1 = active, 0 = disabled)
  sigp_factor         = 0.1,         ! Patch radius scaling factor r_patch = sigp_factor * sigma
  Rcp_factor          = 0.3,         ! Patch interaction cutoff scaling factor Rcp = Rcp_factor * sigma
  Rc_factor           = 2.0,         ! Colloid core attractive tail cutoff scaling factor
  epsp_factor         = -1.0,        ! Colloid core tail depth (< 0 calculates automatically from core)
  patch_radial_factor = 0.5,         ! Radial distance of patches from center (0.5 = at surface sigma/2)
  table_mc            = .true.,      ! Enable MC tabulated potential evaluations on GPU (.true. = tabulated)
  table_file_mc       = 'pot',       ! Base prefix for MC potential table files (pot11.dat, etc.)
  eps_R               = 0.6666667,   ! Pseudo-Hard Sphere (PHS) repulsive energy scale parameter (2/3)
  eps_CSW             = 11.11111,    ! Continuous Square Well (CSW) patch well depth (1/T* = 1/0.09)
  rw_CSW              = 0.12,        ! CSW potential attractive well width
  alpha_CSW           = 0.005,       ! CSW potential well smoothing width parameter
  rc_CSW              = 0.20         ! CSW patch-patch interaction cutoff distance
/

