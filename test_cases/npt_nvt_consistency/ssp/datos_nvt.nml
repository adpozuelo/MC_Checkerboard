! ==============================================================================
! MONTE CARLO SIMULATION CONTROL PARAMETERS - SSP NVT
! ==============================================================================
&Control_Params
  istep_ini   = 0,          ! Initial step number (0 for new simulation, >0 for restart)
  istep_fin   = 5000,       ! Total number of production MC sweeps (steps) to execute
  Neq         = 1000,       ! Number of equilibration sweeps before accumulating averages
  Nmove       = 20,         ! Trial moves per particle attempted in each MC sweep (10 trans + 10 rot)
  Nsave       = 50,         ! Frequency (in sweeps) for writing progress stdout & block averages
  Ndump       = 500,        ! Frequency (in sweeps) for writing trajectory frames
  Nrestart    = 1000,       ! Frequency (in sweeps) for saving restart checkpoints
  imovie      = .false.,    ! Enable trajectory output (.true. / .false.)
  traj_format = 'netcdf',   ! Trajectory output format: 'plain' (text), 'netcdf' (binary), or 'both'
  Npart_types = 2,          ! Number of particle species in system (2 for binary mixture)
  lammps      = .false.     ! Master switch: Enable hybrid LAMMPS HMC moves (.true. / .false.)
/

! ==============================================================================
! MONTE CARLO SAMPLING & THERMODYNAMIC PARAMETERS
! ==============================================================================
&MC_Params
  hmax         = 0.0125,          ! Maximum particle translation step size (in units of sigma)
  omax         = 0.5,             ! Maximum particle rotation step size (in radians)
  vmax         = 0.05, 0.05, 0.05,! Maximum box edge length displacement (Lx, Ly, Lz) for NpT moves
  displ_update = .true.,          ! Enable automatic adjustment of hmax/omax (~40% acceptance)
  temp0        = 0.154,           ! Initial reduced temperature T0* = kB*T/epsilon
  temp1        = 0.154,           ! Final reduced temperature T1*
  npt          = .false.,         ! Isobaric-isothermal ensemble (.true. for NpT, .false. for NVT canonical)
  Nvolf        = 1,               ! Frequency (in sweeps) of NpT volume change attempts
  iscale       = 0,               ! Isotropic box scaling flag (0 = independent Lx,Ly,Lz, 1 = isotropic)
  pres         = 0.05,            ! Reduced pressure P* (unused for NVT)
  seed         = 987,             ! Random number generator seed
  swap_moves   = .false.          ! Identity swap moves between species (.true. / .false.)
/

! ==============================================================================
! POTENTIAL MODEL SELECTION & SSP PALAIA MODEL PARAMETERS
! ==============================================================================
&Potential_Params
  model         = 'SSP',       ! Potential model: 'SSP' (Site-Site Patchy Palaia model)
  sigma_jon_aux = -0.3,        ! Auxiliary angular patch width (< 0 reads individual sigmas_ang)
  sigma_tor_jon = 0.0,         ! Torsional patch interaction width parameter
  rangepp       = 2.5,         ! Radial potential cutoff distance factor (Rcut = rangepp * sigma)
  Bool_tor      = 0,           ! Enable torsional patch alignment (1 = active, 0 = disabled)
  sigp_factor   = 0.1,         ! Patch radius scaling factor r_patch = sigp_factor * sigma
  Rcp_factor    = 0.3,         ! Patch interaction cutoff scaling factor Rcp = Rcp_factor * sigma
  Rc_factor     = 2.0,         ! Colloid core attractive tail cutoff scaling factor R_tail = Rc_factor * Rc
  epsp_factor   = 0.2          ! Colloid core attractive tail well depth eps_tail
/

! ==============================================================================
