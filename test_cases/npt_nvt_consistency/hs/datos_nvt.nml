! ==============================================================================
! MONTE CARLO SIMULATION CONTROL PARAMETERS - HS NVT (Equilibrated at P*=1.0)
! ==============================================================================
&Control_Params
  istep_ini   = 0,          ! Initial step number (0 for new simulation, >0 for restart)
  istep_fin   = 8000,       ! Total number of production MC sweeps to execute
  Neq         = 2000,       ! Number of equilibration sweeps before accumulating averages
  Nmove       = 10,         ! Trial moves per particle attempted in each MC sweep
  Nsave       = 50,         ! Frequency (in sweeps) for writing progress stdout & block averages
  Ndump       = 500,        ! Frequency (in sweeps) for writing trajectory frames
  Nrestart    = 2000,       ! Frequency (in sweeps) for saving restart checkpoints
  imovie      = .false.,    ! Enable trajectory output (.true. / .false.)
  traj_format = 'netcdf',   ! Trajectory output format
  Npart_types = 2,          ! Number of particle species
  lammps      = .false.     ! Master switch: Enable hybrid LAMMPS HMC moves
/
&MC_Params
  hmax         = 0.0125,          ! Maximum particle translation step size
  omax         = 0.5,             ! Maximum particle rotation step size
  vmax         = 0.05, 0.05, 0.05,! Maximum box edge length displacement
  displ_update = .true.,          ! Enable automatic adjustment of hmax (~40% acceptance)
  npt          = .false.,         ! Canonical NVT ensemble
  Nvolf        = 1,               ! Unused for NVT
  iscale       = 0,               ! Unused for NVT
  pres         = 1.0,             ! Target reference pressure
  seed         = 987,             ! Random number generator seed
  swap_moves   = .false.          ! Identity swap moves
/
&Potential_Params
  model = 'HS'
/
--- HS SIGMA MATRIX ---
1.000  1.000
1.000  1.000
