! ==============================================================================
! MONTE CARLO SIMULATION CONTROL PARAMETERS - LJ NPT
! ==============================================================================
&Control_Params
  istep_ini   = 0,          ! Initial step number (0 for new simulation, >0 for restart)
  istep_fin   = 10000,      ! Total number of production MC sweeps (steps) to execute
  Neq         = 2000,       ! Number of equilibration sweeps before accumulating averages
  Nmove       = 10,         ! Trial moves per particle attempted in each MC sweep
  Nsave       = 50,         ! Frequency (in sweeps) for writing progress stdout & block averages
  Ndump       = 500,        ! Frequency (in sweeps) for writing trajectory frames
  Nrestart    = 2000,       ! Frequency (in sweeps) for saving restart checkpoints
  imovie      = .false.,    ! Enable trajectory output (.true. / .false.)
  traj_format = 'netcdf',   ! Trajectory output format: 'plain' (text), 'netcdf' (binary), or 'both'
  Npart_types = 2,          ! Number of particle species in system (2 for binary mixture)
  lammps      = .false.     ! Master switch: Enable hybrid LAMMPS HMC moves (disabled for LJ)
/

! ==============================================================================
! MONTE CARLO SAMPLING & THERMODYNAMIC PARAMETERS
! ==============================================================================
&MC_Params
  hmax         = 0.0125,          ! Maximum particle translation step size (in units of sigma)
  omax         = 0.5,             ! Maximum particle rotation step size (in radians, unused for LJ)
  vmax         = 0.05, 0.05, 0.05,! Maximum box edge length displacement (Lx, Ly, Lz) for NpT moves
  displ_update = .true.,          ! Enable automatic adjustment of hmax/omax/vmax (~40% acceptance)
  temp0        = 1.5,             ! Initial reduced temperature T0* = kB*T/epsilon
  temp1        = 1.5,             ! Final reduced temperature T1*
  npt          = .true.,          ! Isobaric-isothermal ensemble (.true. for NpT, .false. for NVT)
  Nvolf        = 1,               ! Frequency (in sweeps) of NpT volume change attempts
  iscale       = 0,               ! Isotropic box scaling flag (0 = independent Lx,Ly,Lz, 1 = isotropic)
  pres         = 0.60,            ! Reduced pressure P* = P*sigma^3/epsilon (for NpT ensemble)
  seed         = 345,             ! Random number generator seed
  swap_moves   = .false.          ! Identity swap moves between species (.true. / .false.)
/

! ==============================================================================
! POTENTIAL MODEL SELECTION & LJ PARAMETERS
! ==============================================================================
&Potential_Params
  model   = 'LJ',                 ! Potential model: 'LJ' (Truncated & Shifted Lennard-Jones)
  rangepp = 2.5                   ! Cutoff distance factor in units of sigma_ij (Rcut = rangepp * sigma_ij)
/

! ==============================================================================
! LENNARD-JONES PAIR PARAMETER MATRICES
! ==============================================================================
! Symmetric Npart_types x Npart_types matrix of LJ diameter parameters sigma_ij
--- LJ SIGMA MATRIX ---
1.000  1.000
1.000  1.000

! Symmetric Npart_types x Npart_types matrix of LJ potential well depth parameters epsilon_ij
--- LJ EPSILON MATRIX ---
1.000  1.000
1.000  1.000
