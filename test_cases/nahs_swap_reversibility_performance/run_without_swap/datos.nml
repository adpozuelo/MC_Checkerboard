! ==============================================================================
! MONTE CARLO SIMULATION CONTROL PARAMETERS
! ==============================================================================
&Control_Params
  istep_ini   = 0,          ! Initial step number (0 for new simulation, >0 for restart)
  istep_fin   = 50000,      ! Total number of production MC sweeps (steps) to execute
  Neq         = 10000,      ! Number of equilibration sweeps before accumulating averages
  Nmove       = 30,         ! Trial moves per particle attempted in each MC sweep
  Nsave       = 100,        ! Frequency (in sweeps) for writing progress stdout & block averages
  Ndump       = 100,        ! Frequency (in sweeps) for writing trajectory frames
  Nrestart    = 5000,       ! Frequency (in sweeps) for saving restart checkpoints
  imovie      = .false.,    ! Enable trajectory output (.true. / .false.)
  traj_format = 'both',     ! Trajectory output format: 'plain' (text), 'netcdf' (binary), or 'both'
  Npart_types = 2           ! Number of particle species in system (2 for binary mixture)
/

! ==============================================================================
! MONTE CARLO SAMPLING & ALGORITHM PARAMETERS
! ==============================================================================
&MC_Params
  hmax         = 0.002,               ! Maximum particle translation step size (in units of sigma)
  omax         = 0.5,                 ! Maximum particle rotation step size (in radians, unused for HS)
  vmax         = 0.001, 0.001, 0.001, ! Maximum box edge length displacement (Lx, Ly, Lz) for NpT moves
  displ_update = .true.,              ! Enable automatic adjustment of hmax/omax/vmax (~40% acceptance)
  npt          = .true.,              ! Isobaric-isothermal ensemble (.true. for NpT, .false. for NVT)
  iscale       = 0,                   ! Isotropic box scaling flag (0 = independent Lx,Ly,Lz, 1 = isotropic)
  pres         = 70.24,               ! Reduced pressure P* = P*sigma^3/kT (for NpT ensemble)
  seed         = 777,                 ! Random number generator seed
  Nvolf        = 1,                   ! Frequency (in sweeps) of NpT volume change attempts

  ! --- Multicomponent Mixture GPU Identity Swap Moves ---
  swap_moves   = .false.,             ! Enable GPU checkerboard identity swap moves (.true. / .false.)
  Nswap        = 5,                   ! Number of swap sub-passes executed per swap step
  Nswapf       = 10                   ! Frequency (in sweeps) of identity swap attempts
/

! ==============================================================================
! POTENTIAL MODEL SELECTION & HARD SPHERE PARAMETERS
! ==============================================================================
&Potential_Params
  model = 'HS',                       ! Potential model: 'HS' (Hard Sphere athermal mixture)
/

! ==============================================================================
! HARD SPHERE PAIR DIAMETER MATRIX
! ==============================================================================
! Symmetric Npart_types x Npart_types matrix of hard-core particle pair diameters sigma_ij
! Non-additive mixture: sigma_11 = 1.0, sigma_12 = 0.8, sigma_22 = 1.0
--- HS SIGMA MATRIX ---
1.000  0.800
0.800  1.000
