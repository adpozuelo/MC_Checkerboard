#!/bin/bash
# 1. Prepend the correct NVIDIA and MPI and compiler binaries to PATH
export PATH="$NVBIN:$PATH"

# 2. Configure LD_LIBRARY_PATH for the libraries
export LD_LIBRARY_PATH="$HOME/lammps_latest/build:/usr/local/netcdf-nv/lib/:/opt/nvidia/hpc_sdk/Linux_x86_64/2025/compilers/lib:$LD_LIBRARY_PATH"

# 3. Launch using the correct mpirun
exec mpirun -np 1 $HOME/MC_Checkerboard/bin/mc_gpu.exe "$@"
